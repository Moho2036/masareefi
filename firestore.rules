rules_version = '2';

// ===============================================================
// Assumed Data Model (see docs/PLAN.md)
// ===============================================================
//
// All user data lives under users/{uid}. Only the signed-in owner
// (request.auth.uid == uid) may read or write. Everything else is denied.
//
// Collection: users            Document ID: Firebase Auth uid
//   - displayName: string (required, 0..100)
//   - currency: string (required, 1..20)
//   - monthStartDay: int (required, 1..28)
//   - theme: string (required, 'system' | 'light' | 'dark')
//   - rolloverBalance: bool (optional)
//   - createdAt: timestamp (required, immutable)
//   Delete: denied.
//
// Collection: users/{uid}/categories   Document ID: any
//   - name: string (required, 1..40)
//   - type: string (required, 'expense' | 'income', immutable)
//   - icon: string (required, 1..16)
//   - color: string (required, ^#[0-9A-Fa-f]{6}$)
//   - archived: bool (required)
//   - order: int (required, >= 0)
//
// Collection: users/{uid}/transactions Document ID: any
//   - type: string (required, 'expense' | 'income')
//   - amountFils: int (required, 1..1000000000000)
//   - categoryId: string (required, 1..128)
//   - date: timestamp (required)
//   - title: string (optional, 0..100)
//   - note: string (required, 0..500)
//   - recurringId: string (optional, 1..128)
//   - createdAt: timestamp (required, immutable)
//
// Collection: users/{uid}/recurring    Document ID: any
//   - type, amountFils, categoryId, title, note: same as transactions
//   - frequency: string (required, 'weekly' | 'monthly' | 'yearly')
//   - startDate: timestamp (required)
//   - nextDate: timestamp (required)
//   - endDate: timestamp | null (optional)
//   - active: bool (required)
//   - circleId: string (optional, 1..128)
//   - skipMonth: int (optional, 1..50)
//
// Collection: users/{uid}/debts        Document ID: any
//   - personName: string (required, 1..100)
//   - type: string (required, 'lent' | 'borrowed')
//   - amountFils: int (required, 1..1000000000000)
//   - paidFils: int (required, 0..amountFils)
//   - startDate: timestamp (required)
//   - dueDate: timestamp | null (optional)
//   - note: string (required, 0..500)
//   - settled: bool (required)
//   - payments: list (required, <= 100)
//   - createdAt: timestamp (required, immutable)
//
// Collection: users/{uid}/circles      Document ID: any
//   - name: string (required, 1..100)
//   - monthlyAmountFils: int (required, 1..1000000000000)
//   - membersCount: int (required, 2..50)
//   - totalAmountFils: int (required, 1..1000000000000)
//   - myTurnMonth: int (required, 1..membersCount)
//   - startDate: timestamp (required)
//   - members: list (required, <= 50)
//   - status: string (required, 'active' | 'completed')
//   - recurringId: string (optional, 1..128)
//   - isManager: bool (optional)
//   - createdAt: timestamp (required, immutable)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- Helper Functions ----------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isValidAmount(v) {
      return v is int && v > 0 && v <= 1000000000000;
    }

    function isTxType(v) {
      return v in ['expense', 'income'];
    }

    function fieldUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ---------------- Domain Validators ----------------
    function isValidUserProfile(data) {
      return data.keys().hasOnly(['displayName', 'currency', 'monthStartDay', 'theme', 'createdAt', 'rolloverBalance'])
        && data.keys().hasAll(['displayName', 'currency', 'monthStartDay', 'theme', 'createdAt'])
        && isStr(data.displayName, 0, 100)
        && isStr(data.currency, 1, 20)
        && data.monthStartDay is int && data.monthStartDay >= 1 && data.monthStartDay <= 28
        && data.theme in ['system', 'light', 'dark']
        && (!('rolloverBalance' in data) || data.rolloverBalance is bool)
        && data.createdAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['name', 'type', 'icon', 'color', 'archived', 'order'])
        && data.keys().hasAll(['name', 'type', 'icon', 'color', 'archived', 'order'])
        && isStr(data.name, 1, 40)
        && isTxType(data.type)
        && isStr(data.icon, 1, 16)
        && data.color is string && data.color.matches('^#[0-9A-Fa-f]{6}$')
        && data.archived is bool
        && data.order is int && data.order >= 0;
    }

    function isValidTransaction(data) {
      return data.keys().hasOnly(['type', 'amountFils', 'categoryId', 'date', 'title', 'note', 'recurringId', 'createdAt'])
        && data.keys().hasAll(['type', 'amountFils', 'categoryId', 'date', 'note', 'createdAt'])
        && isTxType(data.type)
        && isValidAmount(data.amountFils)
        && isStr(data.categoryId, 1, 128)
        && data.date is timestamp
        && (!('title' in data) || isStr(data.title, 0, 100))
        && isStr(data.note, 0, 500)
        && (!('recurringId' in data) || isStr(data.recurringId, 1, 128))
        && data.createdAt is timestamp;
    }

    function isValidRecurring(data) {
      return data.keys().hasOnly(['type', 'amountFils', 'categoryId', 'title', 'note', 'frequency', 'startDate', 'nextDate', 'endDate', 'active', 'circleId', 'skipMonth'])
        && data.keys().hasAll(['type', 'amountFils', 'categoryId', 'note', 'frequency', 'startDate', 'nextDate', 'active'])
        && isTxType(data.type)
        && isValidAmount(data.amountFils)
        && isStr(data.categoryId, 1, 128)
        && (!('title' in data) || isStr(data.title, 0, 100))
        && isStr(data.note, 0, 500)
        && data.frequency in ['weekly', 'monthly', 'yearly']
        && data.startDate is timestamp
        && data.nextDate is timestamp
        && (!('endDate' in data) || data.endDate == null || data.endDate is timestamp)
        && data.active is bool
        && (!('circleId' in data) || isStr(data.circleId, 1, 128))
        && (!('skipMonth' in data) || (data.skipMonth is int && data.skipMonth >= 1 && data.skipMonth <= 50));
    }

    function isValidDebt(data) {
      return data.keys().hasOnly(['personName', 'type', 'amountFils', 'paidFils', 'startDate', 'dueDate', 'note', 'settled', 'payments', 'createdAt'])
        && data.keys().hasAll(['personName', 'type', 'amountFils', 'paidFils', 'startDate', 'note', 'settled', 'payments', 'createdAt'])
        && isStr(data.personName, 1, 100)
        && data.type in ['lent', 'borrowed']
        && isValidAmount(data.amountFils)
        && data.paidFils is int && data.paidFils >= 0 && data.paidFils <= data.amountFils
        && data.startDate is timestamp
        && (!('dueDate' in data) || data.dueDate == null || data.dueDate is timestamp)
        && isStr(data.note, 0, 500)
        && data.settled is bool
        && data.settled == (data.paidFils == data.amountFils)
        && data.payments is list && data.payments.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidMoneyCircle(data) {
      return data.keys().hasOnly(['name', 'monthlyAmountFils', 'membersCount', 'totalAmountFils', 'myTurnMonth', 'startDate', 'members', 'status', 'createdAt', 'recurringId', 'isManager'])
        && data.keys().hasAll(['name', 'monthlyAmountFils', 'membersCount', 'totalAmountFils', 'myTurnMonth', 'startDate', 'members', 'status', 'createdAt'])
        && isStr(data.name, 1, 100)
        && isValidAmount(data.monthlyAmountFils)
        && data.membersCount is int && data.membersCount >= 2 && data.membersCount <= 50
        && isValidAmount(data.totalAmountFils)
        && data.myTurnMonth is int && data.myTurnMonth >= 1 && data.myTurnMonth <= data.membersCount
        && data.startDate is timestamp
        && data.members is list && data.members.size() <= 50
        && data.status in ['active', 'completed']
        && (!('recurringId' in data) || isStr(data.recurringId, 1, 128))
        && (!('isManager' in data) || data.isManager is bool)
        && data.createdAt is timestamp;
    }

    // ---------------- Rules ----------------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(uid) && isValidUserProfile(request.resource.data)
        && fieldUnchanged('createdAt');
      allow delete: if false;

      match /categories/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidCategory(request.resource.data);
        allow update: if isOwner(uid) && isValidCategory(request.resource.data)
          && fieldUnchanged('type');
      }

      match /transactions/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidTransaction(request.resource.data);
        allow update: if isOwner(uid) && isValidTransaction(request.resource.data)
          && fieldUnchanged('createdAt');
      }

      match /recurring/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidRecurring(request.resource.data);
        allow update: if isOwner(uid) && isValidRecurring(request.resource.data);
      }

      match /debts/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidDebt(request.resource.data);
        allow update: if isOwner(uid) && isValidDebt(request.resource.data)
          && fieldUnchanged('createdAt');
      }

      match /circles/{id} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidMoneyCircle(request.resource.data);
        allow update: if isOwner(uid) && isValidMoneyCircle(request.resource.data)
          && fieldUnchanged('createdAt');
      }
    }

    // Default deny: no other paths are matched, so all other access is denied.
  }
}
