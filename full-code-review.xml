  onClose,
  onSuccess,
}) => {
  const { user } = useAuth()
  const { data: categories, loading: categoriesLoading } = useCategories()
  const { showToast } = useToast()
  const { format: formatCurrency, config: currencyConfig } = useCurrency()

  const isEditing = Boolean(initialRecurring)

  const [type, setType] = useState<TxType>(
    initialRecurring ? initialRecurring.type : defaultType
  )

  const [amountStr, setAmountStr] = useState<string>(() => {
    if (!initialRecurring) return ''
    return String(fromFils(initialRecurring.amountFils))
  })

  const [categoryId, setCategoryId] = useState<string>(
    initialRecurring ? initialRecurring.categoryId : ''
  )

  const [frequency, setFrequency] = useState<Frequency>(
    initialRecurring ? initialRecurring.frequency : 'monthly'
  )

  const [startDateStr, setStartDateStr] = useState<string>(() => {
    if (initialRecurring?.startDate) {
      const d =
        initialRecurring.startDate instanceof Date
          ? initialRecurring.startDate
          : new Date(initialRecurring.startDate)
      return format(d, 'yyyy-MM-dd')
    }
    return format(new Date(), 'yyyy-MM-dd')
  })

  const [hasEndDate, setHasEndDate] = useState<boolean>(Boolean(initialRecurring?.endDate))

  const [endDateStr, setEndDateStr] = useState<string>(() => {
    if (initialRecurring?.endDate) {
      const d =
        initialRecurring.endDate instanceof Date
          ? initialRecurring.endDate
          : new Date(initialRecurring.endDate)
      return format(d, 'yyyy-MM-dd')
    }
    return ''
  })

  const [title, setTitle] = useState<string>(initialRecurring?.title ?? '')
  const [note, setNote] = useState<string>(initialRecurring?.note ?? '')
  const [error, setError] = useState<string | null>(null)
  const [submitting, setSubmitting] = useState(false)

  const { data: circles } = useMoneyCircles()
  const activeCircles = circles.filter((c) => c.status === 'active')

  const [circleId, setCircleId] = useState<string>(initialRecurring?.circleId ?? '')
  const [skipMonth, setSkipMonth] = useState<number | undefined>(initialRecurring?.skipMonth)

  // Filter available categories for current transaction type
  const availableCategories = categories.filter(
    (c) => c.type === type && !c.archived
  )

  const activeCategoryId =
    categoryId && availableCategories.some((c) => c.id === categoryId)
      ? categoryId
      : availableCategories[0]?.id ?? ''

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    setError(null)

    if (!user) {
      setError('يجب تسجيل الدخول أولاً')
      return
    }

    const amountFils = toFils(amountStr)
    if (amountFils <= 0) {
      setError('يرجى إدخال مبلغ صحيح أكبر من الصفر')
      return
    }

    if (!activeCategoryId) {
      setError('يرجى اختيار التصنيف')
      return
    }

    const parsedStartDate = parseLocalDateInput(startDateStr)
    if (isNaN(parsedStartDate.getTime())) {
      setError('يرجى اختيار تاريخ بداية صالح')
      return
    }

    let parsedEndDate: Date | null = null
    if (hasEndDate && endDateStr) {
      parsedEndDate = parseLocalDateInput(endDateStr)
      if (isNaN(parsedEndDate.getTime())) {
        setError('يرجى اختيار تاريخ انتهاء صالح')
        return
      }
      if (parsedEndDate < parsedStartDate) {
        setError('تاريخ الانتهاء يجب أن يكون بعد تاريخ البداية')
        return
      }
    }

    setSubmitting(true)
    try {
      const trimmedTitle = title.trim().slice(0, 100)
      if (isEditing && initialRecurring) {
        const initialStart =
          initialRecurring.startDate instanceof Date
            ? initialRecurring.startDate
            : new Date(initialRecurring.startDate)
        const startDateChanged =
          format(initialStart, 'yyyy-MM-dd') !== format(parsedStartDate, 'yyyy-MM-dd')
        const frequencyChanged = initialRecurring.frequency !== frequency

        const nextDate =
          startDateChanged || frequencyChanged
            ? calculateNextDateOnEdit(parsedStartDate, frequency)
            : undefined

        await updateRecurring(user.uid, initialRecurring.id, {
          type,
          amountFils,
          categoryId: activeCategoryId,
          title: trimmedTitle,
          note: note.trim().slice(0, 500),
          frequency,
          startDate: parsedStartDate,
          ...(nextDate ? { nextDate } : {}),
          endDate: parsedEndDate,
          circleId: circleId || undefined,
          skipMonth: skipMonth !== undefined ? skipMonth : undefined,
        })
        showToast('تم تعديل المعاملة المتكررة بنجاح', 'success')
      } else {
        await addRecurring(user.uid, {
          type,
          amountFils,
          categoryId: activeCategoryId,
          ...(trimmedTitle ? { title: trimmedTitle } : {}),
          note: note.trim().slice(0, 500),
          frequency,
          startDate: parsedStartDate,
          nextDate: parsedStartDate,
          endDate: parsedEndDate ?? undefined,
          active: true,
          circleId: circleId || undefined,
          skipMonth: skipMonth !== undefined ? skipMonth : undefined,
        })
        showToast('تمت إضافة المعاملة المتكررة بنجاح', 'success')
      }

      onSuccess?.()
      onClose()
    } catch (err) {
      console.error('Failed to save recurring transaction:', err)
      setError('تعذر حفظ المعاملة المتكررة. يرجى التحقق من البيانات.')
    } finally {
      setSubmitting(false)
    }
  }

  const typeOptions: { value: TxType; label: string }[] = [
    { value: 'expense', label: 'مصروف' },
    { value: 'income', label: 'دخل' },
  ]

  const frequencyOptions: { value: Frequency; label: string }[] = [
    { value: 'weekly', label: 'أسبوعي' },
    { value: 'monthly', label: 'شهري' },
    { value: 'yearly', label: 'سنوي' },
  ]

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      {/* Type Toggle: مصروف / دخل */}
      <div>
        <SegmentedControl<TxType>
          value={type}
          onChange={(newType) => {
            setType(newType)
            setCategoryId('')
            setError(null)
          }}
          options={typeOptions}
          className="w-full"
        />
      </div>

      {/* Big Amount Input */}
      <div>
        <label
          htmlFor="rec-amount"
          className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1"
        >
          المبلغ
        </label>
        <div
          className={cn(
            'flex items-center justify-between px-4 py-2.5 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border transition-all',
            error && amountStr && toFils(amountStr) <= 0
              ? 'border-red-500 ring-2 ring-red-500/20'
              : 'border-slate-200 dark:border-slate-700 focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/20'
          )}
        >
          <input
            id="rec-amount"
            type="text"
            inputMode="decimal"
            value={amountStr}
            onChange={(e) => {
              setAmountStr(e.target.value)
              setError(null)
            }}
            placeholder="0.000"
            className="w-full bg-transparent text-2xl lg:text-3xl font-black text-slate-800 dark:text-slate-100 placeholder:text-slate-300 dark:placeholder:text-slate-600 outline-none"
            autoFocus={!isEditing}
          />
          <span className="text-base font-bold text-slate-400 dark:text-slate-500 select-none pe-1">
            {currencyConfig.symbol}
          </span>
        </div>
      </div>

      {/* Category Chips Grid */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          التصنيف
        </label>
        {categoriesLoading ? (
          <div className="py-3 text-center text-xs text-slate-400">جاري تحميل التصنيفات...</div>
        ) : availableCategories.length === 0 ? (
          <div className="py-2.5 text-center text-xs text-slate-400 bg-slate-50 dark:bg-slate-900 rounded-xl">
            لا توجد تصنيفات متاحة لهذا النوع
          </div>
        ) : (
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-2 max-h-40 overflow-y-auto p-1">
            {availableCategories.map((cat) => {
              const isSelected = activeCategoryId === cat.id
              return (
                <button
                  key={cat.id}
                  type="button"
                  onClick={() => {
                    setCategoryId(cat.id)
                    setError(null)
                  }}
                  className={cn(
                    'flex items-center gap-2 p-2 rounded-xl border text-xs font-bold transition-all text-start cursor-pointer select-none',
                    isSelected
                      ? 'border-emerald-500 bg-emerald-50 text-emerald-900 dark:bg-emerald-950/60 dark:text-emerald-200 ring-2 ring-emerald-500/20'
                      : 'border-slate-200 dark:border-slate-700/80 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50'
                  )}
                >
                  <span
                    className="w-6 h-6 rounded-lg flex items-center justify-center shrink-0 text-sm"
                    style={{ backgroundColor: `${cat.color}25` }}
                  >
                    {cat.icon}
                  </span>
                  <span className="truncate flex-1">{cat.name}</span>
                  {isSelected && (
                    <Check className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" />
                  )}
                </button>
              )
            })}
          </div>
        )}
      </div>

      {/* Title Input */}
      <div>
        <Input
          type="text"
          label="عنوان المعاملة (اختياري)"
          placeholder="مثال: اشتراك نت، قسط سيارة..."
          value={title}
          onChange={(e) => setTitle(e.target.value)}
          maxLength={100}
        />
      </div>

      {/* Frequency selector: أسبوعي / شهري / سنوي */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          التكرار
        </label>
        <SegmentedControl<Frequency>
          value={frequency}
          onChange={setFrequency}
          options={frequencyOptions}
          className="w-full"
        />
      </div>

      {/* Money Circle Link / Skip Month */}
      {type === 'expense' && activeCircles.length > 0 && (
        <div className="p-3.5 rounded-2xl bg-emerald-50/50 dark:bg-emerald-950/20 border border-emerald-200/80 dark:border-emerald-800/60 space-y-2">
          <label className="block text-xs font-bold text-slate-700 dark:text-slate-300">
            ربط مع جمعية نشطة (تخطي الخصم في شهر الاستلام):
          </label>
          <select
            value={circleId}
            onChange={(e) => {
              const selectedId = e.target.value
              setCircleId(selectedId)
              if (selectedId) {
                const c = activeCircles.find((circ) => circ.id === selectedId)
                if (c) {
                  setSkipMonth(c.myTurnMonth)
                  setFrequency('monthly')
                  if (!title) setTitle(`قسط ${c.name}`)
                  if (!amountStr || parseFloat(amountStr) === 0) setAmountStr(String(fromFils(c.monthlyAmountFils)))
                }
              } else {
                setSkipMonth(undefined)
              }
            }}
            className="w-full px-3 py-2 text-xs rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-hidden focus:ring-1 focus:ring-emerald-500"
          >
            <option value="">-- ليست مرتبطة بجمعية --</option>
            {activeCircles.map((c) => (
              <option key={c.id} value={c.id}>
                {c.name} (قسط: {formatCurrency(c.monthlyAmountFils)} - شهر استلامك: {c.myTurnMonth})
              </option>
            ))}
          </select>
          {circleId && skipMonth && (
            <p className="text-[11px] text-emerald-700 dark:text-emerald-300 font-bold flex items-center gap-1">
              <span>✓ لن يتم خصم قسط منك في الشهر {skipMonth} لأن هذا الشهر هو دور استلامك للجمعية!</span>
            </p>
          )}
        </div>
      )}

      {/* Dates: Start Date & Optional End Date */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <Input
          type="date"
          label="تاريخ البداية"
          value={startDateStr}
          onChange={(e) => setStartDateStr(e.target.value)}
          required
        />

        {hasEndDate ? (
          <Input
            type="date"
            label="تاريخ الانتهاء"
            value={endDateStr}
            onChange={(e) => setEndDateStr(e.target.value)}
            required={hasEndDate}
          />
        ) : null}
      </div>

      {/* Checkbox toggle for end date */}
      <div>
        <Toggle
          checked={hasEndDate}
          onChange={setHasEndDate}
          label="تحديد تاريخ انتهاء"
          description="تتوقف المعاملة المتكررة تلقائياً بعد هذا التاريخ"
        />
      </div>

      {/* Note Input */}
      <div>
        <Input
          type="text"
          label="ملاحظة (اختياري)"
          placeholder="مثال: اشتراك نت، قسط شهري..."
          value={note}
          onChange={(e) => setNote(e.target.value)}
          maxLength={500}
        />
      </div>

      {/* Error message */}
      {error && (
        <div
          role="alert"
          className="p-3 text-start rounded-xl bg-red-50 dark:bg-red-950/40 border border-red-200 dark:border-red-800/50 text-red-600 dark:text-red-400 text-xs font-semibold"
        >
          {error}
        </div>
      )}

      {/* Actions */}
      <div className="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100 dark:border-slate-700/60">
        <Button
          type="button"
          variant="outline"
          onClick={onClose}
          disabled={submitting}
        >
          إلغاء
        </Button>
        <Button
          type="submit"
          variant="primary"
          disabled={submitting}
        >
          {submitting ? 'جاري الحفظ...' : isEditing ? 'تعديل المعاملة' : 'حفظ'}
        </Button>
      </div>
    </form>
  )
}

export const RecurringForm: React.FC<RecurringFormProps> = ({
  isOpen,
  onClose,
  initialRecurring,
  defaultType = 'expense',
  onSuccess,
}) => {
  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={initialRecurring ? 'تعديل المعاملة المتكررة' : 'إضافة معاملة متكررة'}
    >
      <RecurringFormContent
        key={initialRecurring ? `edit-${initialRecurring.id}` : `new-${defaultType}`}
        initialRecurring={initialRecurring}
        defaultType={defaultType}
        onClose={onClose}
        onSuccess={onSuccess}
      />
    </Modal>
  )
}
</file>

<file path="src/pages/DashboardPage.tsx">
import React, { useMemo } from 'react'
import { Link } from 'react-router'
import {
  Plus,
  Receipt,
  Calendar,
  ChevronLeft,
  ArrowUpRight,
  TrendingDown,
  TrendingUp,
  Wallet,
  HandCoins,
  Scale,
  Sparkles,
  Copy,
} from 'lucide-react'
import { PageHeader } from '../components/layout/PageHeader'
import { Button } from '../components/ui/Button'
import { Card } from '../components/ui/Card'
import { EmptyState } from '../components/ui/EmptyState'
import { CategoryPieChart } from '../components/charts/CategoryPieChart'
import { DailyExpenseChart } from '../components/charts/DailyExpenseChart'
import { QuickFeatureHub } from '../components/dashboard/QuickFeatureHub'
import { HeroCardSkeleton } from '../components/skeletons/HeroCardSkeleton'
import { useSelectedMonth } from '../hooks/useSelectedMonth'
import { useTransactions } from '../hooks/useTransactions'
import { useCategories } from '../hooks/useCategories'
import { useRecurring } from '../hooks/useRecurring'
import { useDebts } from '../hooks/useDebts'
import { useUserSettings } from '../hooks/useUserSettings'
import { useCurrency } from '../hooks/useCurrency'
import { useTransactionModal } from '../hooks/useTransactionModal'
import { sumByType } from '../lib/aggregate'
import { calculateCategoryDistribution, calculateDailyExpenses } from '../lib/reports'
import { calculateDebtSummary } from '../lib/debts'
import { calculateForecast } from '../lib/forecast'
import { toWesternDigits, formatDayHeader } from '../lib/dates'
import { format as formatDate } from 'date-fns'
import { ar } from 'date-fns/locale'
import { cn } from '../lib/cn'

export const DashboardPage: React.FC = () => {
  const { range } = useSelectedMonth()
  const { data: rawTransactions, loading: txLoading } = useTransactions(range)
  const { data: categories } = useCategories()
  const { data: recurringList } = useRecurring()
  const { data: debts } = useDebts()
  const { data: settings } = useUserSettings()
  const { format, formatWithSign } = useCurrency()
  const { openAdd, openEdit, openDuplicate } = useTransactionModal()

  const monthStartDay = settings?.monthStartDay ?? 1

  // Calculate monthly totals
  const sums = useMemo(() => sumByType(rawTransactions), [rawTransactions])

  // Calculate forecast & daily safe budget
  const forecast = useMemo(() => {
    return calculateForecast({
      transactions: rawTransactions,
      recurring: recurringList,
      debts,
      monthStartDay,
      periodRange: range,
    })
  }, [rawTransactions, recurringList, debts, monthStartDay, range])

  // Calculate active debts summary
  const debtSummary = useMemo(() => calculateDebtSummary(debts), [debts])

  // Map categoryId to Category object
  const categoryMap = useMemo(() => {
    const map = new Map<string, (typeof categories)[0]>()
    for (const c of categories) {
      map.set(c.id, c)
    }
    return map
  }, [categories])

  // Category distribution for donut chart
  const categoryDistribution = useMemo(
    () => calculateCategoryDistribution(rawTransactions, categories, 'expense'),
    [rawTransactions, categories]
  )

  // Daily expenses for trend area chart
  const dailyExpenses = useMemo(
    () => calculateDailyExpenses(rawTransactions, range.start, range.end),
    [rawTransactions, range.start, range.end]
  )

  // Up to 5 most recent transactions
  const recentTransactions = useMemo(
    () => rawTransactions.slice(0, 5),
    [rawTransactions]
  )

  // Up to 5 upcoming active recurring items
  const upcomingRecurring = useMemo(() => {
    return recurringList
      .filter((r) => r.active)
      .sort((a, b) => {
        const dateA = a.nextDate instanceof Date ? a.nextDate : new Date(a.nextDate)
        const dateB = b.nextDate instanceof Date ? b.nextDate : new Date(b.nextDate)
        return dateA.getTime() - dateB.getTime()
      })
      .slice(0, 5)
  }, [recurringList])

  const today = useMemo(() => new Date(), [])

  // Guard against initial loading state where rawTransactions is [] and txLoading is true,
  // preventing calculation of deficit (danger/red flash) for fractions of a second before data arrives
  const isInitialOrLoading = txLoading && rawTransactions.length === 0

  // Dynamic Hero Card Palette based on financial health:
  // safe (excellent) -> Emerald / Green (lighter, vibrant, distinct)
  // warning (medium) -> Amber / Yellow (warm, bright, clear)
  // danger (bad) -> Rose / Red (striking, clear crimson)
  const heroTheme = useMemo(() => {
    const status = isInitialOrLoading ? 'safe' : forecast.healthStatus
    if (status === 'safe') {
      return {
        cardBg:
          'bg-gradient-to-br from-emerald-600 via-emerald-700 to-teal-800 border-emerald-400/40 shadow-xl shadow-emerald-900/15',
        walletBg: 'bg-white/20 text-white',
        badge: 'bg-white/20 text-white border-white/30 backdrop-blur-xs',
        badgeText: isInitialOrLoading
          ? 'جاري التحديث...'
          : sums.balance >= 0
            ? 'فائض مالي'
            : 'عجز مالي',
        subBox: 'bg-white/10 hover:bg-white/15 border-white/20 text-white backdrop-blur-xs',
        subLabel: 'text-emerald-100',
        stripBg: 'bg-white/15 hover:bg-white/20 border-white/25 text-white backdrop-blur-xs',
        stripText: 'text-emerald-100',
      }
    }
    if (status === 'warning') {
      return {
        cardBg:
          'bg-gradient-to-br from-amber-600 via-amber-700 to-yellow-800 border-amber-400/40 shadow-xl shadow-amber-900/15',
        walletBg: 'bg-white/20 text-white',
        badge: 'bg-white/20 text-white border-white/30 backdrop-blur-xs',
        badgeText: 'انتبه للوتيرة',
        subBox: 'bg-white/10 hover:bg-white/15 border-white/20 text-white backdrop-blur-xs',
        subLabel: 'text-amber-100',
        stripBg: 'bg-white/15 hover:bg-white/20 border-white/25 text-white backdrop-blur-xs',
        stripText: 'text-amber-100',
      }
    }
    return {
      cardBg:
        'bg-gradient-to-br from-rose-600 via-red-700 to-rose-800 border-rose-400/40 shadow-xl shadow-rose-900/20',
      walletBg: 'bg-white/20 text-white',
      badge: 'bg-white/20 text-white border-white/30 backdrop-blur-xs',
      badgeText: sums.balance < 0 ? 'عجز مالي' : 'وتيرة إنفاق حرجة',
      subBox: 'bg-white/10 hover:bg-white/15 border-white/20 text-white backdrop-blur-xs',
      subLabel: 'text-rose-100',
      stripBg: 'bg-white/15 hover:bg-white/20 border-white/25 text-white backdrop-blur-xs',
      stripText: 'text-rose-100',
    }
  }, [isInitialOrLoading, forecast.healthStatus, sums.balance])

  return (
    <div className="space-y-6 animate-slide-up">
      {/* Header with Title and Desktop-only Quick Add */}
      <PageHeader
        title="لوحة التحكم"
        subtitle="نظرة شاملة وسريعة على وضعك المالي لهذا الشهر"
        actions={
          <Button
            variant="primary"
            size="md"
            onClick={() => openAdd('expense')}
            className="hidden lg:inline-flex gap-1.5 shadow-xs font-semibold press-scale"
          >
            <Plus className="w-4 h-4" />
            <span>إضافة معاملة</span>
          </Button>
        }
      />

      {/* 1. Hero Card: Clean, Vibrant, High-Contrast Cash Balance */}
      {isInitialOrLoading ? (
        <HeroCardSkeleton />
      ) : (
        <div
          className={cn(
            'text-white rounded-2xl sm:rounded-3xl p-5 sm:p-6 shadow-md border space-y-4 transition-colors duration-300',
            heroTheme.cardBg
          )}
        >
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2.5">
              <div
                className={cn(
                  'w-8 h-8 rounded-xl flex items-center justify-center',
                  heroTheme.walletBg
                )}
              >
                <Wallet className="w-4 h-4 stroke-[2.2]" />
              </div>
              <span className="text-xs sm:text-sm font-semibold text-white/90">
                الرصيد المتاح (لهذا الشهر)
              </span>
            </div>
            <span
              className={cn(
                'text-xs font-black px-2.5 py-0.5 rounded-full select-none border',
                heroTheme.badge
              )}
            >
              {heroTheme.badgeText}
            </span>
          </div>

          <div className="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight select-none">
            {format(sums.balance)}
          </div>

          {/* Total Income & Total Expenses Row */}
          <div className="grid grid-cols-2 gap-3 pt-3 border-t border-white/15">
            <div
              className={cn(
                'flex items-center gap-2.5 p-2.5 rounded-xl border',
                heroTheme.subBox
              )}
            >
              <div className="w-8 h-8 rounded-lg bg-white/20 flex items-center justify-center text-white shrink-0 font-bold">
                <TrendingUp className="w-4 h-4 stroke-[2.5]" />
              </div>
              <div className="min-w-0">
