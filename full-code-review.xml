<file path="src/lib/money.ts">
export interface CurrencyInfo {
  code: string
  name: string
  symbol: string
  decimals: number
  flag: string
}

export const PRESET_CURRENCIES: Record<string, CurrencyInfo> = {
  JOD: { code: 'JOD', name: 'دينار أردني', symbol: 'د.أ', decimals: 3, flag: '🇯🇴' },
  SAR: { code: 'SAR', name: 'ريال سعودي', symbol: 'ر.س', decimals: 2, flag: '🇸🇦' },
  USD: { code: 'USD', name: 'دولار أمريكي', symbol: '$', decimals: 2, flag: '🇺🇸' },
  EUR: { code: 'EUR', name: 'يورو أوروبي', symbol: '€', decimals: 2, flag: '🇪🇺' },
  AED: { code: 'AED', name: 'درهم إماراتي', symbol: 'د.إ', decimals: 2, flag: '🇦🇪' },
}

export function getCurrencyConfig(currencyCode?: string): CurrencyInfo {
  if (!currencyCode || currencyCode === 'JOD') {
    return PRESET_CURRENCIES.JOD
  }
  if (PRESET_CURRENCIES[currencyCode]) {
    return PRESET_CURRENCIES[currencyCode]
  }
  // Custom user currency: default to 2 decimal places with the custom string as symbol
  const clean = currencyCode.trim().slice(0, 20)
  return {
    code: clean,
    name: clean,
    symbol: clean,
    decimals: 2,
    flag: '🪙',
  }
}

export interface FormatOptions {
  showCurrency?: boolean
  currency?: string
}

export type FormatJODOptions = FormatOptions

const formattersCache = new Map<number, Intl.NumberFormat>()

function getFormatter(decimals: number): Intl.NumberFormat {
  let formatter = formattersCache.get(decimals)
  if (!formatter) {
    formatter = new Intl.NumberFormat('ar-JO', {
      numberingSystem: 'latn',
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    })
    formattersCache.set(decimals, formatter)
  }
  return formatter
}

/**
 * Converts a currency amount (string or number) into integer thousandths (1 unit = 1000 fils/base units).
 * Handles inputs like '12.5', '12.500', '1,250.500', '12,5', '12,500', Arabic numerals, etc.
 */
export function toFils(input: string | number): number {
  if (typeof input === 'number') {
    if (isNaN(input) || !isFinite(input)) return 0
    return Math.round(input * 1000)
  }

  if (typeof input !== 'string') return 0

  // Normalize Eastern Arabic / Persian numerals to Latin
  const normalized = input
    .replace(/[٠-٩]/g, (d) => String(d.charCodeAt(0) - 1632))
    .replace(/[۰-۹]/g, (d) => String(d.charCodeAt(0) - 1776))
    .trim()

  if (!normalized) return 0

  // Strip all whitespace
  let clean = normalized.replace(/\s+/g, '')

  // Handle both comma and dot present
  if (clean.includes(',') && clean.includes('.')) {
    const lastComma = clean.lastIndexOf(',')
    const lastDot = clean.lastIndexOf('.')
    if (lastComma < lastDot) {
      // 1,250.50 -> comma is thousands separator
      clean = clean.replace(/,/g, '')
    } else {
      // 1.250,50 -> dot is thousands separator
      clean = clean.replace(/\./g, '').replace(/,/g, '.')
    }
  } else if (clean.includes(',')) {
    // Only comma present
    const commaCount = (clean.match(/,/g) || []).length
    if (commaCount > 1) {
      // Multiple commas e.g. 1,000,000 -> thousands separator
      clean = clean.replace(/,/g, '')
    } else {
      // Single comma and no dot: always treat as decimal comma
      clean = clean.replace(',', '.')
    }
  }

  const num = parseFloat(clean)
  if (isNaN(num) || !isFinite(num)) return 0
  return Math.round(num * 1000)
}

/**
 * Converts integer base units back to decimal units (e.g. 12500 -> 12.5).
 */
export function fromFils(fils: number): number {
  if (isNaN(fils) || !isFinite(fils)) return 0
  return fils / 1000
}

/**
 * Formats amount according to specified currency (or JOD by default).
 */
export function formatMoney(
  fils: number,
  currencyCode?: string,
  opts: FormatOptions = {}
): string {
  const code = currencyCode || opts.currency
  const config = getCurrencyConfig(code)
  const amount = fromFils(fils)
  const formatter = getFormatter(config.decimals)
  const formattedNumber = formatter.format(amount)

  if (opts.showCurrency === false) {
    return formattedNumber
  }
  return `${formattedNumber} ${config.symbol}`
}

/**
 * Formats fils as currency representation (defaults to JOD for backward compatibility).
 */
export function formatJOD(fils: number, opts: FormatOptions = {}): string {
  return formatMoney(fils, opts.currency, opts)
}

/**
 * Formats fils with a leading positive (+) or negative (-) sign based on transaction type.
 * e.g. formatSigned(12500, 'income') -> "+ 12.500 د.أ"
 *      formatSigned(12500, 'expense') -> "- 12.500 د.أ"
 */
export function formatSigned(
  fils: number,
  type: 'expense' | 'income',
  opts: FormatOptions = {}
): string {
  const prefix = type === 'income' ? '+ ' : '- '
  const absFormatted = formatMoney(Math.abs(fils), opts.currency, opts)
  return `${prefix}${absFormatted}`
}
</file>

<file path="src/lib/recurring.ts">
import { addDays, addMonths, addYears, format } from 'date-fns'
import type { Frequency, Recurring } from '../types'

/**
 * Advances a date by one interval according to frequency.
 * - weekly: +7 days
 * - monthly: +1 month (safely clamped to end-of-month e.g. Jan 31 -> Feb 28)
 * - yearly: +1 year (clamped for leap year Feb 29 -> Feb 28)
 */
export function advanceDate(date: Date, freq: Frequency): Date {
  const d = new Date(date.getTime())
  switch (freq) {
    case 'weekly':
      return addDays(d, 7)
    case 'monthly':
      return addMonths(d, 1)
    case 'yearly':
      return addYears(d, 1)
  }
}

/**
 * Generates an idempotent, deterministic transaction ID based on recurringId and date.
 * Format: `${recurringId}_${YYYY-MM-DD}`
 */
export function getDeterministicTxId(recurringId: string, date: Date): string {
  const dateKey = format(date, 'yyyy-MM-dd')
  return `${recurringId}_${dateKey}`
}

export interface DueOccurrencesResult {
  dates: Date[]
  newNextDate: Date
  shouldDeactivate: boolean
}

/**
 * Calculates the 1-based month index of an occurrence relative to the start date.
 * Example: start 2026-01-15, occurrence 2026-01-15 -> 1
 * occurrence 2026-02-15 -> 2
 * occurrence 2026-04-15 -> 4
 */
export function getOccurrenceMonthIndex(startDate: Date, occurrenceDate: Date): number {
  const start = startDate instanceof Date ? startDate : new Date(startDate)
  const occ = occurrenceDate instanceof Date ? occurrenceDate : new Date(occurrenceDate)
  const diffMonths =
    (occ.getFullYear() - start.getFullYear()) * 12 +
    (occ.getMonth() - start.getMonth()) +
    1
  return diffMonths
}

/**
 * Determines whether a recurring occurrence should be skipped.
 * For money circles, the user's turn month is exempt from paying an installment.
 */
export function isOccurrenceSkipped(recurring: Recurring, occurrenceDate: Date): boolean {
  if (recurring.skipMonth === undefined || recurring.skipMonth === null) {
    return false
  }
  const monthIdx = getOccurrenceMonthIndex(recurring.startDate, occurrenceDate)
  return monthIdx === recurring.skipMonth
}

/**
 * Calculates due occurrences for a recurring transaction up to `today`.
 * Compares against end-of-day so occurrences due today are not skipped if opened in the morning.
 * Collects each due date and advances `nextDate` until nextDate > today or nextDate > endDate.
 * If an occurrence matches skipMonth (e.g. money circle turn month), it is NOT added to dates
 * (no transaction is created), but nextDate still advances past it.
 */
export function calculateDueOccurrences(
  recurring: Recurring,
  today: Date = new Date()
): DueOccurrencesResult {
  const dates: Date[] = []
  let curNextDate = new Date(recurring.nextDate.getTime())

  // Normalize today and endDate to end-of-day so occurrences due today (even if at noon)
  // are processed even when the user opens the app in the morning.
  const endOfToday = new Date(today.getTime())
  endOfToday.setHours(23, 59, 59, 999)

  const endOfEndDate = recurring.endDate ? new Date(recurring.endDate.getTime()) : null
  if (endOfEndDate) {
    endOfEndDate.setHours(23, 59, 59, 999)
  }

  // Safety safeguard against unbounded iterations
  let loopLimit = 500

  while (curNextDate <= endOfToday && loopLimit-- > 0) {
    if (endOfEndDate && curNextDate > endOfEndDate) {
      break
    }
    // Only push to dates if this occurrence is NOT skipped
    if (!isOccurrenceSkipped(recurring, curNextDate)) {
      dates.push(new Date(curNextDate.getTime()))
    }
    curNextDate = advanceDate(curNextDate, recurring.frequency)
  }

  const shouldDeactivate = Boolean(
    endOfEndDate && curNextDate > endOfEndDate
  )

  return {
    dates,
    newNextDate: curNextDate,
    shouldDeactivate,
  }
}

/**
 * Calculates the updated nextDate when editing an existing recurring transaction whose
 * startDate or frequency was modified.
 * - If newStartDate is in the future (after today's date), nextDate is set to newStartDate.
 * - Otherwise, advances from newStartDate by frequency until reaching the first upcoming occurrence (>= today).
 */
export function calculateNextDateOnEdit(
  newStartDate: Date,
  frequency: Frequency,
  today: Date = new Date()
): Date {
  const startOfToday = new Date(today.getTime())
  startOfToday.setHours(0, 0, 0, 0)

  const startOfNewStart = new Date(newStartDate.getTime())
  startOfNewStart.setHours(0, 0, 0, 0)

  if (startOfNewStart > startOfToday) {
    return new Date(newStartDate.getTime())
  }

  let candidate = new Date(newStartDate.getTime())
  let loopLimit = 1000

  while (candidate < startOfToday && loopLimit-- > 0) {
    candidate = advanceDate(candidate, frequency)
  }

  return candidate
}

export interface MonthlyEquivalentResult {
  monthlyIncome: number
  monthlyExpense: number
}

/**
 * Calculates normalized monthly income and expense for active recurring items.
 * - weekly: amount * (52 / 12)
 * - monthly: amount * 1
 * - yearly: amount / 12
 * If an item is a money circle whose turn month matches refDate, its expense is 0 this month.
 */
export function calculateMonthlyEquivalent(
  items: Recurring[],
  refDate: Date = new Date()
): MonthlyEquivalentResult {
  let monthlyIncome = 0
  let monthlyExpense = 0

  for (const item of items) {
    if (!item.active) continue

    // If this month is the skipped turn month for this item, no installment is due
    if (item.type === 'expense' && isOccurrenceSkipped(item, refDate)) {
      continue
    }

    let equivalentFils = 0
    switch (item.frequency) {
      case 'weekly':
        equivalentFils = Math.round(item.amountFils * (52 / 12))
        break
      case 'monthly':
        equivalentFils = item.amountFils
        break
      case 'yearly':
        equivalentFils = Math.round(item.amountFils / 12)
        break
    }

    if (item.type === 'income') {
      monthlyIncome += equivalentFils
    } else {
      monthlyExpense += equivalentFils
    }
  }

  return {
    monthlyIncome,
    monthlyExpense,
  }
}
</file>

<file path="src/lib/reports.ts">
import type { Transaction, Category, TxType } from '../types'

export interface DailyExpenseItem {
  day: number
  date: Date
  amountFils: number
}

export interface CategoryDistributionItem {
  categoryId: string
  name: string
  icon: string
  color: string
  amountFils: number
  percentage: number
}

export interface MonthlyBreakdownItem {
  monthIndex: number
  monthName: string
  income: number
  expense: number
  balance: number
}

export const ARABIC_MONTH_NAMES = [
  'يناير',
  'فبراير',
  'مارس',
  'أبريل',
  'مايو',
  'يونيو',
  'يوليو',
  'أغسطس',
  'سبتمبر',
  'أكتوبر',
  'نوفمبر',
  'ديسمبر',
] as const

/**
 * Calculates daily expense breakdown for every single calendar day within [start, end).
 * Ensures days with 0 expenses are present to provide a smooth continuous chart line/area.
 */
export function calculateDailyExpenses(
  txs: Transaction[],
  start: Date,
  end: Date
): DailyExpenseItem[] {
  const current = new Date(start)
  current.setHours(0, 0, 0, 0)
  const endBoundary = new Date(end)
  endBoundary.setHours(0, 0, 0, 0)

  if (current.getTime() >= endBoundary.getTime()) {
    return []
  }

  // Pre-aggregate expenses by YYYY-MM-DD
  const expenseMap = new Map<string, number>()
  for (const tx of txs) {
    if (tx.type !== 'expense') continue
    const txDate = tx.date instanceof Date ? tx.date : new Date(tx.date)
    const y = txDate.getFullYear()
    const m = String(txDate.getMonth() + 1).padStart(2, '0')
    const d = String(txDate.getDate()).padStart(2, '0')
    const key = `${y}-${m}-${d}`
    expenseMap.set(key, (expenseMap.get(key) || 0) + tx.amountFils)
  }

  const result: DailyExpenseItem[] = []
  while (current.getTime() < endBoundary.getTime()) {
    const y = current.getFullYear()
    const m = String(current.getMonth() + 1).padStart(2, '0')
    const d = String(current.getDate()).padStart(2, '0')
    const key = `${y}-${m}-${d}`
    const amountFils = expenseMap.get(key) || 0

    result.push({
      day: current.getDate(),
      date: new Date(current),
      amountFils,
    })

    current.setDate(current.getDate() + 1)
  }

  return result
}

/**
 * Groups transactions by category, calculates total amounts and percentages (rounded to 1 decimal).
 * Sorts descending by amountFils.
 */
export function calculateCategoryDistribution(
  txs: Transaction[],
  categories: Category[],
  type: TxType = 'expense'
): CategoryDistributionItem[] {
  const categoryMap = new Map<string, Category>()
  for (const c of categories) {
    categoryMap.set(c.id, c)
  }

  const totals = new Map<string, number>()
  let totalFils = 0

  for (const tx of txs) {
    if (tx.type !== type) continue
    totals.set(tx.categoryId, (totals.get(tx.categoryId) || 0) + tx.amountFils)
    totalFils += tx.amountFils
  }

  if (totalFils === 0 || totals.size === 0) {
    return []
  }

  const items: CategoryDistributionItem[] = []
  for (const [catId, amount] of totals.entries()) {
    if (amount <= 0) continue
    const cat = categoryMap.get(catId)
    const percentage =
      totalFils > 0 ? Math.round((amount / totalFils) * 1000) / 10 : 0

    items.push({
      categoryId: catId,
      name: cat ? cat.name : 'غير مصنف',
      icon: cat ? cat.icon : '📁',
      color: cat ? cat.color : '#94A3B8',
      amountFils: amount,
      percentage,
    })
  }

  // Sort descending by amount
  items.sort((a, b) => b.amountFils - a.amountFils)

  return items
}

/**
 * Aggregates all transactions for a specific year into 12 months (indices 0..11).
 * Zero-fills months with no activity.
 */
export function calculateYearlyBreakdown(
  txs: Transaction[],
  year: number
): MonthlyBreakdownItem[] {
  const monthlyData: { income: number; expense: number }[] = Array.from(
    { length: 12 },
    () => ({ income: 0, expense: 0 })
  )

  for (const tx of txs) {
    const txDate = tx.date instanceof Date ? tx.date : new Date(tx.date)
    if (txDate.getFullYear() !== year) continue

    const monthIndex = txDate.getMonth()
    if (monthIndex >= 0 && monthIndex < 12) {
      if (tx.type === 'income') {
        monthlyData[monthIndex].income += tx.amountFils
      } else if (tx.type === 'expense') {
        monthlyData[monthIndex].expense += tx.amountFils
      }
    }
  }

  return monthlyData.map((data, index) => ({
    monthIndex: index,
    monthName: ARABIC_MONTH_NAMES[index],
    income: data.income,
    expense: data.expense,
    balance: data.income - data.expense,
  }))
}

/**
 * Calculates the savings rate percentage: ((income - expense) / income) * 100.
 * Clamped between -100% and 100%. Returns 0 if income <= 0.
 * Rounded to 1 decimal place.
 */
export function calculateSavingsRate(income: number, expense: number): number {
  if (income <= 0) {
    return 0
  }

  const rawRate = ((income - expense) / income) * 100
  const clamped = Math.max(-100, Math.min(100, rawRate))
  return Math.round(clamped * 10) / 10
}
</file>

