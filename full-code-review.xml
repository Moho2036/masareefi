<file path="src/components/tools/WorkHoursCalculator.tsx">
import React, { useState, useMemo } from 'react'
import {
  Clock,
  Briefcase,
  Sparkles,
  ShoppingBag,
} from 'lucide-react'
import { Card } from '../ui/Card'
import { Input } from '../ui/Input'
import { useCurrency } from '../../hooks/useCurrency'
import { toFils } from '../../lib/money'
import { cn } from '../../lib/cn'

const STORAGE_KEY = 'masareefi_work_hours_prefs'

export const WorkHoursCalculator: React.FC = () => {
  const { format, config } = useCurrency()

  // Salary & Work schedule preferences initialized from localStorage
  const [salaryStr, setSalaryStr] = useState<string>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY)
      if (saved) {
        const parsed = JSON.parse(saved)
        if (parsed.salary) return String(parsed.salary)
      }
    } catch {
      // ignore
    }
    return '500'
  })

  const [dailyHoursStr, setDailyHoursStr] = useState<string>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY)
      if (saved) {
        const parsed = JSON.parse(saved)
        if (parsed.dailyHours) return String(parsed.dailyHours)
      }
    } catch {
      // ignore
    }
    return '8'
  })

  const [workDaysStr, setWorkDaysStr] = useState<string>(() => {
    try {
      const saved = localStorage.getItem(STORAGE_KEY)
      if (saved) {
        const parsed = JSON.parse(saved)
        if (parsed.workDays) return String(parsed.workDays)
      }
    } catch {
      // ignore
    }
    return '22'
  })

  // Item to buy
  const [itemName, setItemName] = useState<string>('هاتف ذكي')
  const [itemPriceStr, setItemPriceStr] = useState<string>('250')

  // Save preferences
  const handleSavePreferences = () => {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          salary: salaryStr,
          dailyHours: dailyHoursStr,
          workDays: workDaysStr,
        })
      )
    } catch {
      // ignore
    }
  }

  // Calculations
  const salary = parseFloat(salaryStr) || 0
  const dailyHours = parseFloat(dailyHoursStr) || 8
  const workDays = parseFloat(workDaysStr) || 22
  const itemPrice = parseFloat(itemPriceStr) || 0

  const totalMonthlyHours = useMemo(() => {
    return Math.max(1, dailyHours * workDays)
  }, [dailyHours, workDays])

  // Hourly wage in fils
  const hourlyWageFils = useMemo(() => {
    if (salary <= 0) return 0
    const salaryFils = toFils(salary)
    return Math.round(salaryFils / totalMonthlyHours)
  }, [salary, totalMonthlyHours])

  // Required hours of life to purchase item
  const requiredHours = useMemo(() => {
    if (hourlyWageFils <= 0 || itemPrice <= 0) return 0
    const itemPriceFils = toFils(itemPrice)
    return itemPriceFils / hourlyWageFils
  }, [hourlyWageFils, itemPrice])

  const fullHours = Math.floor(requiredHours)
  const remainingMinutes = Math.round((requiredHours - fullHours) * 60)
  const equivalentWorkDays = (requiredHours / Math.max(1, dailyHours)).toFixed(1)

  // Psychological impact tier
  const impactTier = useMemo(() => {
    if (requiredHours <= 4) return 'light'
    if (requiredHours <= 24) return 'medium'
    return 'heavy'
  }, [requiredHours])

  return (
    <div className="space-y-6">
      {/* Introduction Card */}
      <Card className="border-emerald-500/20 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent">
        <div className="flex items-start gap-3">
          <div className="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
            <Clock className="w-5 h-5" />
          </div>
          <div>
            <h3 className="text-base font-black text-slate-800 dark:text-slate-100">
              حاسبة تكلفة الشراء بساعات العمل (Hours of Life)
            </h3>
            <p className="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
              عندما تشتري شيئاً، أنت لا تدفع ثمنه بالمال فقط، بل بجزء لا يعوض من وقتك وجهدك. هذه
              الأداة تكشف لك كم ساعة عمل شاقة يتطلبها كل قرار شراء قبل أن تتخذه!
            </p>
          </div>
        </div>
      </Card>

      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Left Column: Work Settings & Item Input */}
        <div className="lg:col-span-5 space-y-5">
          {/* Work & Salary Card */}
          <Card title="بيانات العمل والراتب" subtitle="تُستخدم لاحتساب قيمتك بالساعة بدقة">
            <div className="space-y-3.5 pt-1">
              <div>
                <Input
                  label={`صافي راتبك الشهري (${config.symbol})`}
                  type="number"
                  min="0"
                  step="any"
                  value={salaryStr}
                  onChange={(e) => {
                    setSalaryStr(e.target.value)
                    handleSavePreferences()
                  }}
                  startIcon={<Briefcase className="w-4 h-4 text-slate-400" />}
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <Input
                  label="ساعات الدوام / يوم"
                  type="number"
                  min="1"
                  max="24"
                  value={dailyHoursStr}
                  onChange={(e) => {
                    setDailyHoursStr(e.target.value)
                    handleSavePreferences()
                  }}
                  startIcon={<Clock className="w-4 h-4 text-slate-400" />}
                />

                <Input
                  label="أيام العمل / شهر"
                  type="number"
                  min="1"
                  max="31"
                  value={workDaysStr}
                  onChange={(e) => {
                    setWorkDaysStr(e.target.value)
                    handleSavePreferences()
                  }}
                />
              </div>

              <div className="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-750/60 flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
                <span className="font-medium">صافي أجرك في الساعة الواحدة:</span>
                <span className="font-black text-emerald-600 dark:text-emerald-400">
                  {format(hourlyWageFils)} / ساعة
                </span>
              </div>
            </div>
          </Card>

          {/* Item details */}
          <Card title="السلعة المراد شراؤها" subtitle="ما الشيء الذي تفكر في شرائه الآن؟">
            <div className="space-y-3.5 pt-1">
              <Input
                label="اسم السلعة أو الخدمة"
                placeholder="مثال: ساعة يد، وجبة فاخرة، جوال"
                value={itemName}
                onChange={(e) => setItemName(e.target.value)}
                startIcon={<ShoppingBag className="w-4 h-4 text-slate-400" />}
              />

              <Input
                label={`سعر السلعة (${config.symbol})`}
                type="number"
                min="0"
                step="any"
                placeholder="0.00"
                value={itemPriceStr}
                onChange={(e) => setItemPriceStr(e.target.value)}
              />
            </div>
          </Card>
        </div>

        {/* Right Column: Visual Result Card */}
        <div className="lg:col-span-7">
          <Card className="h-full flex flex-col justify-between border-2 border-emerald-500/20 bg-white dark:bg-slate-800">
            <div>
              <div className="flex items-center justify-between pb-3 border-b border-slate-100 dark:border-slate-800">
                <span className="text-xs font-bold text-slate-400">التكلفة الحقيقية للشراء</span>
                <span
                  className={cn(
                    'text-xs font-black px-2.5 py-1 rounded-full',
                    impactTier === 'light' &&
                      'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300',
                    impactTier === 'medium' &&
                      'bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300',
                    impactTier === 'heavy' &&
                      'bg-rose-100 dark:bg-rose-950/60 text-rose-700 dark:text-rose-300'
                  )}
                >
                  {impactTier === 'light' && '🟢 عبء خفيف'}
                  {impactTier === 'medium' && '🟡 عبء متوسط'}
                  {impactTier === 'heavy' && '🔴 عبء ثقيل جداً'}
                </span>
              </div>

              {/* Main hours counter */}
              <div className="py-6 text-center space-y-2">
                <p className="text-xs font-semibold text-slate-400">
                  لشراء <span className="font-bold text-slate-700 dark:text-slate-200">"{itemName || 'هذه السلعة'}"</span> بسعر {format(toFils(itemPrice))}، تحتاج إلى:
                </p>

                <div className="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white select-none tracking-tight">
                  {fullHours}{' '}
                  <span className="text-xl sm:text-2xl font-bold text-emerald-600 dark:text-emerald-400">
                    ساعة
                  </span>
                  {remainingMinutes > 0 && (
                    <span className="text-2xl sm:text-3xl font-extrabold text-slate-400 ms-2">
                      و {remainingMinutes} دقيقة
                    </span>
                  )}
                </div>

                <div className="text-sm font-bold text-slate-500 dark:text-slate-400 flex items-center justify-center gap-1.5 pt-1">
                  <Briefcase className="w-4 h-4 text-emerald-500" />
                  <span>
                    ما يعادل تقريباً{' '}
                    <strong className="text-emerald-600 dark:text-emerald-400 font-black">
                      {equivalentWorkDays}
                    </strong>{' '}
                    يوم دوام كامل!
                  </span>
                </div>
              </div>

              {/* Psychological Reflection Banner */}
              <div
                className={cn(
                  'p-4 rounded-2xl border text-xs leading-relaxed space-y-1.5',
                  impactTier === 'light' &&
                    'bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800/50 text-emerald-900 dark:text-emerald-200',
                  impactTier === 'medium' &&
                    'bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50 text-amber-900 dark:text-amber-200',
                  impactTier === 'heavy' &&
                    'bg-rose-50 dark:bg-rose-950/30 border-rose-200 dark:border-rose-800/50 text-rose-900 dark:text-rose-200'
                )}
              >
                <div className="font-bold flex items-center gap-1.5">
                  <Sparkles className="w-4 h-4" />
                  <span>سؤال مالي للتأمل قبل الدفع:</span>
                </div>
                {impactTier === 'light' && (
                  <p>
                    هذه السلعة تكلف أقل من نصف يوم عمل. إذا كانت تلبي رغبة حقيقية، يمكنك شراؤها
                    بضمير مرتاح!
                  </p>
                )}
                {impactTier === 'medium' && (
                  <p>
                    هذه السلعة تكلفك من يوم إلى 3 أيام من العمل والاستيقاظ مبكراً. هل قيمتها وفائدتها
                    تستحق هذا العناء فعلاً؟ خذ مهلة 24 ساعة قبل الشراء.
                  </p>
                )}
                {impactTier === 'heavy' && (
                  <p>
                    ⚠️ <strong>تريّث بشدة!</strong> شراء هذه السلعة يستهلك أكثر من أسبوع كامل من حياتك
                    المهنية وجهدك. هل هي حاجة ملحة أم رغبة لحظية ستزول فرحتها بعد أيام؟
                  </p>
                )}
              </div>
            </div>

            {/* Quick comparison benchmarks */}
            <div className="pt-4 border-t border-slate-100 dark:border-slate-800/80 mt-4">
              <div className="text-[11px] font-bold text-slate-400 mb-2">أمثلة سريعة للمقارنة:</div>
              <div className="grid grid-cols-3 gap-2">
                <button
                  type="button"
                  onClick={() => {
                    setItemName('كوب قهوة مختصة')
                    setItemPriceStr('3.5')
                  }}
                  className="p-2 rounded-xl bg-slate-100 dark:bg-slate-750 text-center hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer text-xs font-semibold text-slate-700 dark:text-slate-300"
                >
                  ☕ قهوة (3.5)
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setItemName('عشاء مطعم')
                    setItemPriceStr('25')
                  }}
                  className="p-2 rounded-xl bg-slate-100 dark:bg-slate-750 text-center hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer text-xs font-semibold text-slate-700 dark:text-slate-300"
                >
                  🍔 عشاء (25)
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setItemName('حذاء رياضي')
                    setItemPriceStr('75')
                  }}
                  className="p-2 rounded-xl bg-slate-100 dark:bg-slate-750 text-center hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer text-xs font-semibold text-slate-700 dark:text-slate-300"
                >
                  👟 حذاء (75)
                </button>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  )
}
