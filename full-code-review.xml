import React from 'react'
import { format } from 'date-fns'
import { ar } from 'date-fns/locale'
import { History, Pencil, Trash2, Plus, Calendar, AlertCircle, CheckCircle2 } from 'lucide-react'
import type { Debt } from '../../types'
import { useCurrency } from '../../hooks/useCurrency'
import { getDebtRemainingFils, getDebtProgress, isDebtOverdue } from '../../lib/debts'
import { toWesternDigits } from '../../lib/dates'
import { cn } from '../../lib/cn'

export interface DebtCardProps {
  debt: Debt
  onOpenPaymentModal: (debt: Debt) => void
  onOpenHistoryModal: (debt: Debt) => void
  onEdit: (debt: Debt) => void
  onDelete: (debt: Debt) => void
}

export const DebtCard: React.FC<DebtCardProps> = ({
  debt,
  onOpenPaymentModal,
  onOpenHistoryModal,
  onEdit,
  onDelete,
}) => {
  const { format: formatCurrency } = useCurrency()
  const remainingFils = getDebtRemainingFils(debt)
  const progress = getDebtProgress(debt)
  const overdue = isDebtOverdue(debt)
  const isLent = debt.type === 'lent'
  const firstLetter = (debt.personName || '').trim().charAt(0) || '؟'

  const formattedStartDate = toWesternDigits(
    format(debt.startDate, 'd MMMM yyyy', { locale: ar })
  )
  const formattedDueDate = debt.dueDate
    ? toWesternDigits(format(debt.dueDate, 'd MMMM yyyy', { locale: ar }))
    : null

  return (
    <div
      className={cn(
        'group rounded-2xl p-4 sm:p-5 border transition-all flex flex-col justify-between shadow-xs hover:shadow-sm space-y-3.5 relative overflow-hidden',
        'bg-white dark:bg-slate-800',
        debt.settled
          ? 'border-slate-200/60 dark:border-slate-700/40 opacity-75'
          : overdue
            ? 'border-amber-300 dark:border-amber-700/80'
            : isLent
              ? 'border-slate-200/80 dark:border-slate-700/60 hover:border-emerald-300 dark:hover:border-emerald-700/60'
              : 'border-slate-200/80 dark:border-slate-700/60 hover:border-red-300 dark:hover:border-red-700/60'
      )}
    >
      {/* Top Row: Avatar, Person info & Badges */}
      <div className="flex items-start justify-between gap-3">
        <div className="flex items-center gap-3 min-w-0">
          <div
            className={cn(
              'w-10 h-10 rounded-xl flex items-center justify-center text-base shrink-0 font-black shadow-xs',
              isLent
                ? 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300'
                : 'bg-red-500/15 text-red-700 dark:text-red-300'
            )}
          >
            {firstLetter}
          </div>
          <div className="min-w-0">
            <span className="font-extrabold text-base text-slate-800 dark:text-slate-100 block truncate">
              {debt.personName}
            </span>
            {debt.note && (
              <p className="text-xs text-slate-400 dark:text-slate-400 truncate mt-0.5" title={debt.note}>
                {debt.note}
              </p>
            )}
          </div>
        </div>

        {/* Badges */}
        <div className="flex items-center gap-1.5 shrink-0">
          {debt.settled ? (
            <span className="inline-flex items-center gap-1 text-[11px] px-2.5 py-1 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 font-bold border border-emerald-200/60 dark:border-emerald-800/40 shadow-xs">
              <CheckCircle2 className="w-3.5 h-3.5" />
              <span>مسدد</span>
            </span>
          ) : overdue ? (
            <span className="inline-flex items-center gap-1 text-[11px] px-2.5 py-1 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 font-bold border border-amber-200/60 dark:border-amber-800/40 shadow-xs">
              <AlertCircle className="w-3.5 h-3.5" />
              <span>متأخر</span>
            </span>
          ) : null}

          <span
            className={cn(
              'text-xs px-3 py-1 rounded-xl font-black shrink-0 border shadow-xs',
              isLent
                ? 'bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-400 border-emerald-200/60 dark:border-emerald-900/40'
                : 'bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 border-red-200/60 dark:border-red-900/40'
            )}
          >
            {isLent ? 'لي (مستحق)' : 'عليّ (التزام)'}
          </span>
        </div>
      </div>

      {/* Middle: Remaining Amount & Breakdown */}
      <div className="p-3 rounded-xl bg-slate-50/70 dark:bg-slate-900/40 border border-slate-100 dark:border-slate-700/50 space-y-2">
        <div className="flex items-end justify-between gap-2">
          <div>
            <span className="text-[11px] font-bold text-slate-400 dark:text-slate-400 block mb-0.5">
              {debt.settled ? 'تم السداد بالكامل' : isLent ? 'المبلغ المتبقي لك' : 'المبلغ المتبقي عليك'}
            </span>
            <div
              className={cn(
                'text-2xl sm:text-3xl font-black select-none tracking-tight',
                debt.settled
                  ? 'text-slate-400 dark:text-slate-500 line-through'
                  : isLent
                    ? 'text-emerald-600 dark:text-emerald-400'
                    : 'text-red-500 dark:text-red-400'
              )}
            >
              {formatCurrency(remainingFils)}
            </div>
          </div>
          <div className="text-end">
            <span className="text-xs font-bold px-2 py-0.5 rounded-lg bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60 shadow-xs">
              {progress}% مسدد
            </span>
          </div>
        </div>

        <div className="flex items-center justify-between text-xs text-slate-400 dark:text-slate-400 pt-1">
          <span>المبلغ الأصلي: <strong className="text-slate-600 dark:text-slate-300">{formatCurrency(debt.amountFils)}</strong></span>
          <span>المسدد: <strong className="text-emerald-600 dark:text-emerald-400">{formatCurrency(debt.paidFils || 0)}</strong></span>
        </div>

        {/* Progress Bar */}
        <div className="w-full bg-slate-200/70 dark:bg-slate-700/60 rounded-full h-2 overflow-hidden mt-2">
          <div
            className={cn(
              'h-full transition-all duration-300 rounded-full',
              debt.settled
                ? 'bg-emerald-500'
                : isLent
                  ? 'bg-emerald-500'
                  : 'bg-red-500'
            )}
            style={{ width: `${progress}%` }}
          />
        </div>
      </div>

      {/* Dates Row */}
      <div className="text-[11px] text-slate-400 dark:text-slate-400 flex flex-wrap items-center gap-3 px-1">
        <span className="flex items-center gap-1 font-medium">
          <Calendar className="w-3.5 h-3.5 text-slate-400" />
          <span>منذ: {formattedStartDate}</span>
        </span>
        {formattedDueDate && (
          <span
            className={cn(
              'flex items-center gap-1 font-medium',
              overdue && !debt.settled
                ? 'text-amber-600 dark:text-amber-400 font-bold'
                : 'text-slate-400'
            )}
          >
            <AlertCircle className="w-3.5 h-3.5" />
            <span>الاستحقاق: {formattedDueDate}</span>
          </span>
        )}
      </div>

      {/* Bottom Row: Actions */}
      <div className="pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between gap-2 text-xs">
        {!debt.settled ? (
          <button
            type="button"
            onClick={() => onOpenPaymentModal(debt)}
            className={cn(
              'px-4 py-2 rounded-xl font-bold transition-all cursor-pointer flex items-center gap-1.5 shadow-xs active:scale-95',
              isLent
                ? 'bg-emerald-600 hover:bg-emerald-700 text-white'
                : 'bg-red-600 hover:bg-red-700 text-white'
            )}
          >
            <Plus className="w-4 h-4 stroke-[2.5]" />
            <span>تسجيل {isLent ? 'دفعة استرداد' : 'دفعة سداد'}</span>
          </button>
        ) : (
          <span className="text-xs text-emerald-600 dark:text-emerald-400 font-bold flex items-center gap-1 py-1.5 px-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40">
            <CheckCircle2 className="w-4 h-4" />
            <span>تم السداد بالكامل</span>
          </span>
        )}

        <div className="flex items-center gap-1 shrink-0">
          <button
            type="button"
            onClick={() => onOpenHistoryModal(debt)}
            className="p-2 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 dark:hover:text-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer relative"
            title="سجل الدفعات"
          >
            <History className="w-4 h-4" />
            {(debt.payments?.length ?? 0) > 0 && (
              <span className="absolute -top-1 -end-1 px-1 min-w-[14px] h-[14px] rounded-full bg-emerald-500 text-white text-[9px] font-black flex items-center justify-center">
                {debt.payments.length}
              </span>
            )}
          </button>
          <button
            type="button"
            onClick={() => onEdit(debt)}
            className="p-2 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100 dark:hover:text-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
            title="تعديل"
          >
            <Pencil className="w-4 h-4" />
          </button>
          <button
            type="button"
            onClick={() => onDelete(debt)}
            className="p-2 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:text-red-400 dark:hover:bg-red-950/40 transition-colors cursor-pointer"
            title="حذف"
          >
            <Trash2 className="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>
  )
}
</file>

<file path="src/components/debts/DebtFormModal.tsx">
import React, { useState } from 'react'
import { format } from 'date-fns'
import { Modal } from '../ui/Modal'
import { Button } from '../ui/Button'
import { Input } from '../ui/Input'
import { Toggle } from '../ui/Toggle'
import { useAuth } from '../../hooks/useAuth'
import { useToast } from '../../hooks/useToast'
import { addDebt, updateDebt } from '../../services/debts'
import { toFils, fromFils } from '../../lib/money'
import { parseLocalDateInput } from '../../lib/dates'
import { useCurrency } from '../../hooks/useCurrency'
import { cn } from '../../lib/cn'
import type { Debt, DebtType } from '../../types'

export interface DebtFormModalProps {
  isOpen: boolean
  onClose: () => void
  initialDebt?: Debt | null
  onSuccess?: () => void
}

interface DebtFormContentProps {
  initialDebt?: Debt | null
  onClose: () => void
  onSuccess?: () => void
}

const DebtFormContent: React.FC<DebtFormContentProps> = ({
  initialDebt,
  onClose,
  onSuccess,
}) => {
  const { user } = useAuth()
  const { showToast } = useToast()
  const { format: formatCurrency, config } = useCurrency()

  const isEditing = Boolean(initialDebt)

  const [type, setType] = useState<DebtType>(() => initialDebt?.type ?? 'lent')
  const [personName, setPersonName] = useState(() => initialDebt?.personName ?? '')
  const [amountStr, setAmountStr] = useState(() =>
    initialDebt ? String(fromFils(initialDebt.amountFils)) : ''
  )
  const [startDateStr, setStartDateStr] = useState(() =>
    initialDebt?.startDate
      ? format(new Date(initialDebt.startDate), 'yyyy-MM-dd')
      : format(new Date(), 'yyyy-MM-dd')
  )
  const [hasDueDate, setHasDueDate] = useState(() => Boolean(initialDebt?.dueDate))
  const [dueDateStr, setDueDateStr] = useState(() =>
    initialDebt?.dueDate ? format(new Date(initialDebt.dueDate), 'yyyy-MM-dd') : ''
  )
  const [note, setNote] = useState(() => initialDebt?.note ?? '')
  const [syncTransaction, setSyncTransaction] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [loading, setLoading] = useState(false)

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!user) return

    const trimmedName = personName.trim()
    if (!trimmedName) {
      setError('يرجى إدخال اسم الشخص')
      return
    }

    const amountFils = toFils(amountStr)
    if (amountFils <= 0) {
      setError('يرجى إدخال مبلغ صحيح أكبر من الصفر')
      return
    }

    if (isEditing && initialDebt && amountFils < (initialDebt.paidFils || 0)) {
      setError(
        `المبلغ الجديد لا يمكن أن يقل عن المبالغ المسددة مسبقاً (${formatCurrency(initialDebt.paidFils)})`
      )
      return
    }

    setLoading(true)
    setError(null)

    try {
      const startDate = parseLocalDateInput(startDateStr)
      const dueDate = hasDueDate && dueDateStr ? parseLocalDateInput(dueDateStr) : null

      if (dueDate && dueDate < startDate) {
        setError('موعد الاستحقاق لا يمكن أن يسبق تاريخ الدين')
        setLoading(false)
        return
      }

      if (isEditing && initialDebt) {
        await updateDebt(user.uid, initialDebt.id, {
          personName: trimmedName,
          type,
          amountFils,
          paidFils: initialDebt.paidFils ?? 0,
          startDate,
          dueDate,
          note: note.trim(),
        })
        showToast('تم تحديث بيانات الدين بنجاح', 'success')
      } else {
        const defaultDebtNote = type === 'lent' ? 'دين مستحق (لي)' : 'دين مستحق (عليّ)'
        const safeNote = note.trim() || defaultDebtNote
        await addDebt(
          user.uid,
          {
            personName: trimmedName,
            type,
            amountFils,
            startDate,
            dueDate,
            note: safeNote,
          },
          { syncTransaction }
        )
        showToast('تمت إضافة الدين بنجاح', 'success')
      }

      onSuccess?.()
      onClose()
    } catch (err) {
      console.error('Error saving debt:', err)
      setError(err instanceof Error ? err.message : 'حدث خطأ أثناء حفظ الدين')
    } finally {
      setLoading(false)
    }
  }

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      {error && (
        <div className="p-3 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900/60 rounded-xl text-xs font-semibold">
          {error}
        </div>
      )}

      {/* 1. Type Selector (Segmented control) */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          نوع الدين
        </label>
        <div className="inline-flex items-center p-1 rounded-xl bg-slate-100 dark:bg-slate-850 border border-slate-200/60 dark:border-slate-700/60 gap-1 w-full">
          <button
            type="button"
            onClick={() => setType('lent')}
            className={cn(
              'flex-1 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center justify-center gap-1.5',
              type === 'lent'
                ? 'bg-white dark:bg-slate-700 text-emerald-600 dark:text-emerald-400 shadow-xs'
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'
            )}
          >
            <span className="w-2 h-2 rounded-full bg-emerald-500 shrink-0" />
            <span>لي (أنا داينت فلان)</span>
          </button>
          <button
            type="button"
            onClick={() => setType('borrowed')}
            className={cn(
              'flex-1 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer flex items-center justify-center gap-1.5',
              type === 'borrowed'
                ? 'bg-white dark:bg-slate-700 text-red-600 dark:text-red-400 shadow-xs'
                : 'text-slate-600 dark:text-slate-400 hover:text-slate-900'
            )}
          >
            <span className="w-2 h-2 rounded-full bg-red-500 shrink-0" />
            <span>عليّ (أنا استدنت)</span>
          </button>
        </div>
      </div>

      {/* 2. Person Name */}
      <div>
        <Input
          label="اسم الشخص"
          placeholder="مثال: أحمد العبدلله"
          value={personName}
          onChange={(e) => setPersonName(e.target.value)}
          required
          maxLength={100}
        />
      </div>

      {/* 3. Amount Input in JOD */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          المبلغ الكلي
        </label>
        <div className="flex items-center justify-between px-4 py-2 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-700 focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/20">
          <input
            type="text"
            inputMode="decimal"
            placeholder="0.000"
            value={amountStr}
            onChange={(e) => setAmountStr(e.target.value)}
            className="w-full bg-transparent text-2xl font-black text-slate-800 dark:text-slate-100 placeholder:text-slate-300 dark:placeholder:text-slate-600 outline-none"
            required
          />
          <span className="text-base font-bold text-slate-400 dark:text-slate-500 select-none pe-1">
            {config.symbol}
          </span>
        </div>
      </div>

      {/* 4. Start Date */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          تاريخ الدين
        </label>
        <input
          type="date"
          value={startDateStr}
          onChange={(e) => setStartDateStr(e.target.value)}
          className="w-full rounded-xl border bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2 text-sm outline-none border-slate-200 dark:border-slate-700 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 font-medium"
          required
        />
      </div>

      {/* 5. Due Date Toggle */}
      <div className="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200/60 dark:border-slate-700/60 space-y-2">
        <div className="flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-700 dark:text-slate-300 block">
              تحديد موعد استحقاق
            </span>
            <span className="text-[11px] text-slate-400">
              تنبيه عند حلول موعد السداد المتفق عليه
            </span>
          </div>
          <input
            type="checkbox"
            checked={hasDueDate}
            onChange={(e) => {
              setHasDueDate(e.target.checked)
              if (e.target.checked && !dueDateStr) {
                setDueDateStr(format(new Date(), 'yyyy-MM-dd'))
              }
            }}
            className="w-4 h-4 accent-emerald-500 cursor-pointer"
          />
        </div>

        {hasDueDate && (
          <div className="pt-2">
            <input
              type="date"
              value={dueDateStr}
              onChange={(e) => setDueDateStr(e.target.value)}
              className="w-full rounded-xl border bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2 text-sm outline-none border-slate-200 dark:border-slate-700 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 font-medium"
              required={hasDueDate}
            />
          </div>
        )}
      </div>

      {/* 6. Note */}
      <div>
        <Input
          label="ملاحظات وتفاصيل (اختياري)"
          placeholder="مثال: سبب السلفة، طريقة التسليم..."
          value={note}
          onChange={(e) => setNote(e.target.value)}
          maxLength={500}
        />
      </div>

      {/* 7. Accounting Sync Toggle (new debts only) */}
      {!isEditing && (
        <div className="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200/60 dark:border-slate-700/60">
          <Toggle
            checked={syncTransaction}
            onChange={setSyncTransaction}
            label={
              type === 'lent'
                ? 'خصم المبلغ من الرصيد الحالي تلقائياً'
                : 'إضافة المبلغ للرصيد الحالي (استلمت المبلغ نقداً)'
            }
            description={
              type === 'lent'
                ? 'تسجيل المعاملة كمصروف لتحديث الرصيد الفعلي'
                : 'تسجيل المعاملة كدخل لتحديث الرصيد الفعلي'
            }
          />
        </div>
      )}

      {/* Actions */}
      <div className="pt-2 flex items-center gap-3">
        <Button
          type="submit"
          variant="primary"
          className="flex-1 font-bold"
          disabled={loading}
        >
          {loading ? 'جارٍ الحفظ...' : isEditing ? 'تحديث الدين' : 'حفظ الدين'}
        </Button>
        <Button
          type="button"
          variant="outline"
          onClick={onClose}
          disabled={loading}
        >
          إلغاء
        </Button>
      </div>
    </form>
  )
}

export const DebtFormModal: React.FC<DebtFormModalProps> = ({
  isOpen,
  onClose,
  initialDebt,
  onSuccess,
}) => {
  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={initialDebt ? 'تعديل بيانات الدين' : 'إضافة دين جديد'}
    >
      {isOpen && (
        <DebtFormContent
          key={initialDebt?.id ?? 'new'}
          initialDebt={initialDebt}
          onClose={onClose}
          onSuccess={onSuccess}
        />
      )}
    </Modal>
  )
}
</file>

<file path="src/components/debts/PaymentHistoryModal.tsx">
import React, { useState } from 'react'
import { format } from 'date-fns'
import { ar } from 'date-fns/locale'
import { Trash2, AlertCircle } from 'lucide-react'
import { Modal } from '../ui/Modal'
import { Button } from '../ui/Button'
import { useAuth } from '../../hooks/useAuth'
import { useToast } from '../../hooks/useToast'
import { deleteDebtPayment } from '../../services/debts'
import { useCurrency } from '../../hooks/useCurrency'
import { getDebtRemainingFils } from '../../lib/debts'
import { toWesternDigits } from '../../lib/dates'
import type { Debt } from '../../types'

export interface PaymentHistoryModalProps {
  isOpen: boolean
  onClose: () => void
  debt: Debt | null
  onSuccess?: () => void
}

export const PaymentHistoryModal: React.FC<PaymentHistoryModalProps> = ({
  isOpen,
  onClose,
  debt,
  onSuccess,
}) => {
  const { user } = useAuth()
  const { showToast } = useToast()
  const { format: formatCurrency } = useCurrency()
  const [deletingId, setDeletingId] = useState<string | null>(null)
  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null)

  const handleClose = () => {
    setConfirmDeleteId(null)
    onClose()
  }

  if (!debt) return null

  const remainingFils = getDebtRemainingFils(debt)
  const payments = debt.payments || []

  const handleDeletePayment = async (paymentId: string) => {
    if (!user) return

    setDeletingId(paymentId)
    try {
      await deleteDebtPayment(user.uid, debt, paymentId)
      showToast('تم حذف الدفعة وتحديث الرصيد', 'success')
      setConfirmDeleteId(null)
      onSuccess?.()
    } catch (err) {
      console.error('Error deleting payment:', err)
      showToast(err instanceof Error ? err.message : 'فشل حذف الدفعة', 'error')
    } finally {
      setDeletingId(null)
    }
  }

  return (
    <Modal
      isOpen={isOpen}
      onClose={handleClose}
      title={`سجل الدفعات — ${debt.personName}`}
    >
      <div className="space-y-4">
        {/* Summary Card */}
        <div className="p-3.5 rounded-2xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-700/60 grid grid-cols-3 gap-2 text-center">
          <div>
            <span className="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-0.5">المبلغ الأصلي</span>
            <span className="text-xs sm:text-sm font-black text-slate-700 dark:text-slate-200">
              {formatCurrency(debt.amountFils)}
            </span>
          </div>
          <div>
            <span className="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-0.5">المسدد حتى الآن</span>
            <span className="text-xs sm:text-sm font-black text-emerald-600 dark:text-emerald-400">
              {formatCurrency(debt.paidFils || 0)}
            </span>
          </div>
          <div>
            <span className="text-xs font-semibold text-slate-500 dark:text-slate-400 block mb-0.5">المتبقي</span>
            <span className="text-xs sm:text-sm font-black text-slate-800 dark:text-slate-100">
              {formatCurrency(remainingFils)}
            </span>
          </div>
        </div>

        {/* Payments List */}
        {payments.length === 0 ? (
          <div className="text-center py-8 text-slate-400 dark:text-slate-500">
            <AlertCircle className="w-8 h-8 mx-auto mb-2 opacity-50" />
            <p className="text-xs font-semibold">لا توجد أي دفعات مسجلة بعد لهذا الدين</p>
          </div>
        ) : (
          <div className="space-y-2 max-h-60 overflow-y-auto pe-1">
            {payments
              .slice()
              .reverse()
              .map((p) => {
                const formattedDate = toWesternDigits(
                  format(p.date, 'd MMMM yyyy', { locale: ar })
                )
                const isDeleting = deletingId === p.id

                return (
                  <div
                    key={p.id}
                    className="p-3 rounded-xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200/60 dark:border-slate-700/60 flex items-center justify-between gap-3"
                  >
                    <div className="min-w-0">
                      <div className="text-sm font-black text-emerald-600 dark:text-emerald-400">
                        + {formatCurrency(p.amountFils)}
                      </div>
                      <div className="text-[11px] text-slate-400 dark:text-slate-500 mt-0.5 truncate">
                        {formattedDate}
                        {p.note ? ` • ${p.note}` : ''}
                      </div>
                    </div>

                    {confirmDeleteId === p.id ? (
                      <div className="flex items-center gap-1.5 shrink-0">
                        <button
                          type="button"
                          disabled={isDeleting}
                          onClick={() => handleDeletePayment(p.id)}
                          className="px-2.5 py-1 text-xs font-bold rounded-lg bg-red-600 hover:bg-red-700 text-white transition-colors cursor-pointer disabled:opacity-50"
                        >
                          {isDeleting ? 'جاري الحذف...' : 'تأكيد الحذف'}
                        </button>
                        <button
                          type="button"
                          disabled={isDeleting}
                          onClick={() => setConfirmDeleteId(null)}
                          className="px-2 py-1 text-xs font-semibold rounded-lg bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-300 dark:hover:bg-slate-600 transition-colors cursor-pointer"
                        >
                          إلغاء
                        </button>
                      </div>
                    ) : (
                      <button
                        type="button"
                        disabled={Boolean(deletingId)}
                        onClick={() => setConfirmDeleteId(p.id)}
                        className="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400 rounded-lg transition-colors cursor-pointer disabled:opacity-50"
                        title="حذف هذه الدفعة"
                      >
                        <Trash2 className="w-4 h-4" />
                      </button>
                    )}
                  </div>
                )
              })}
          </div>
        )}

        <div className="pt-2">
          <Button
            type="button"
            variant="outline"
            className="w-full font-bold"
            onClick={handleClose}
          >
            إغلاق
          </Button>
        </div>
      </div>
    </Modal>
  )
}
</file>

<file path="src/components/debts/PaymentModal.tsx">
import React, { useState } from 'react'
import { format } from 'date-fns'
import { Zap } from 'lucide-react'
import { Modal } from '../ui/Modal'
import { Button } from '../ui/Button'
import { Input } from '../ui/Input'
import { Toggle } from '../ui/Toggle'
import { useAuth } from '../../hooks/useAuth'
import { useToast } from '../../hooks/useToast'
import { addDebtPayment } from '../../services/debts'
import { toFils, fromFils } from '../../lib/money'
import { useCurrency } from '../../hooks/useCurrency'
import { getDebtRemainingFils } from '../../lib/debts'
import { parseLocalDateInput } from '../../lib/dates'
import { cn } from '../../lib/cn'
import type { Debt } from '../../types'

export interface PaymentModalProps {
  isOpen: boolean
  onClose: () => void
  debt: Debt | null
  onSuccess?: () => void
}

interface PaymentFormContentProps {
  debt: Debt
  onClose: () => void
  onSuccess?: () => void
}

const PaymentFormContent: React.FC<PaymentFormContentProps> = ({
  debt,
  onClose,
  onSuccess,
}) => {
  const { user } = useAuth()
  const { showToast } = useToast()
  const { format: formatCurrency, config } = useCurrency()

  const [amountStr, setAmountStr] = useState('')
  const [dateStr, setDateStr] = useState(() => format(new Date(), 'yyyy-MM-dd'))
  const [note, setNote] = useState('')
  const [syncTransaction, setSyncTransaction] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [loading, setLoading] = useState(false)

  const remainingFils = getDebtRemainingFils(debt)
  const isLent = debt.type === 'lent'

  const handleFillFullRemaining = () => {
    setAmountStr(String(fromFils(remainingFils)))
    setError(null)
  }

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!user) return

    const amountFils = toFils(amountStr)
    if (amountFils <= 0) {
      setError('يرجى إدخال مبلغ صحيح أكبر من الصفر')
      return
    }

    if (amountFils > remainingFils) {
      setError(`مبلغ الدفعة لا يمكن أن يتجاوز المبلغ المتبقي (${formatCurrency(remainingFils)})`)
      return
    }

    setLoading(true)
    setError(null)

    try {
      const date = parseLocalDateInput(dateStr)
      const fallbackNote = isLent ? 'استرداد دفعة دين' : 'سداد دفعة دين'
      await addDebtPayment(
        user.uid,
        debt,
        {
          amountFils,
          date,
          note: note.trim() || fallbackNote,
        },
        { syncTransaction }
      )

      showToast('تم تسجيل الدفعة بنجاح', 'success')
      onSuccess?.()
      onClose()
    } catch (err) {
      console.error('Error adding debt payment:', err)
      setError(err instanceof Error ? err.message : 'حدث خطأ أثناء تسجيل الدفعة')
    } finally {
      setLoading(false)
    }
  }

  return (
    <form onSubmit={handleSubmit} className="space-y-4">
      {error && (
        <div className="p-3 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-900/60 rounded-xl text-xs font-semibold">
          {error}
        </div>
      )}

      {/* Debt Info Card */}
      <div
        className={cn(
          'p-3.5 rounded-2xl border flex items-center justify-between',
          isLent
            ? 'bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200/60 dark:border-emerald-900/40'
            : 'bg-red-50 dark:bg-red-950/40 border-red-200/60 dark:border-red-900/40'
        )}
      >
        <div>
          <span
            className={cn(
              'text-xs font-bold block',
              isLent
                ? 'text-emerald-800 dark:text-emerald-300'
                : 'text-red-800 dark:text-red-300'
            )}
          >
            {debt.personName}
          </span>
          <span
            className={cn(
              'text-[11px] font-medium',
              isLent
                ? 'text-emerald-600 dark:text-emerald-400'
                : 'text-red-600 dark:text-red-400'
            )}
          >
            المبلغ المتبقي الحالي
          </span>
        </div>
        <span
          className={cn(
            'text-lg font-black',
            isLent
              ? 'text-emerald-700 dark:text-emerald-300'
              : 'text-red-700 dark:text-red-300'
          )}
        >
          {formatCurrency(remainingFils)}
        </span>
      </div>

      {/* Amount Input */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          مبلغ الدفعة
        </label>
        <div className="flex items-center justify-between px-4 py-2 bg-slate-50 dark:bg-slate-900/60 rounded-2xl border border-slate-200 dark:border-slate-700 focus-within:border-emerald-500 focus-within:ring-2 focus-within:ring-emerald-500/20">
          <input
            type="text"
            inputMode="decimal"
            placeholder="0.000"
            value={amountStr}
            onChange={(e) => setAmountStr(e.target.value)}
            className="w-full bg-transparent text-2xl font-black text-slate-800 dark:text-slate-100 placeholder:text-slate-300 dark:placeholder:text-slate-600 outline-none"
            required
          />
          <span className="text-base font-bold text-slate-400 dark:text-slate-500 select-none pe-1">
            {config.symbol}
          </span>
        </div>
      </div>

      {/* Quick Fill Button */}
      {remainingFils > 0 && (
        <button
          type="button"
          onClick={handleFillFullRemaining}
          className="w-full py-2 px-3 rounded-xl bg-slate-100 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300 text-xs font-bold hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <Zap className="w-3.5 h-3.5 text-amber-500" />
          <span>سداد كامل المبلغ المتبقي ({formatCurrency(remainingFils)}) بنقرة واحدة</span>
        </button>
      )}

      {/* Date */}
      <div>
        <label className="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-1.5">
          تاريخ الدفعة
        </label>
        <input
          type="date"
          value={dateStr}
          onChange={(e) => setDateStr(e.target.value)}
          className="w-full rounded-xl border bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 px-3.5 py-2 text-sm outline-none border-slate-200 dark:border-slate-700 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 font-medium"
          required
        />
      </div>

      {/* Note */}
      <div>
        <Input
          label="ملاحظة الدفعة (اختياري)"
          placeholder="مثال: تحويل كليك / نقد باليد"
          value={note}
          onChange={(e) => setNote(e.target.value)}
          maxLength={500}
        />
      </div>

      {/* Accounting Sync Toggle */}
      <div className="p-3 bg-slate-50 dark:bg-slate-900/40 rounded-xl border border-slate-200/60 dark:border-slate-700/60">
        <Toggle
          checked={syncTransaction}
          onChange={setSyncTransaction}
          label={
            isLent
              ? 'إضافة الدفعة إلى الرصيد الحالي تلقائياً'
              : 'خصم الدفعة من الرصيد الحالي تلقائياً'
          }
          description={
            isLent
              ? 'تسجيل المعاملة كدخل لتحديث الرصيد الفعلي'
              : 'تسجيل المعاملة كمصروف لتحديث الرصيد الفعلي'
          }
        />
      </div>

      {/* Actions */}
      <div className="pt-2 flex items-center gap-3">
        <Button
          type="submit"
          variant="primary"
          className="flex-1 font-bold"
          disabled={loading}
        >
          {loading ? 'جارٍ التسجيل...' : 'تأكيد تسجيل الدفعة'}
        </Button>
        <Button
          type="button"
          variant="outline"
          onClick={onClose}
          disabled={loading}
        >
          إلغاء
        </Button>
      </div>
    </form>
  )
}

export const PaymentModal: React.FC<PaymentModalProps> = ({
  isOpen,
  onClose,
  debt,
  onSuccess,
}) => {
  if (!debt) return null

  const isLent = debt.type === 'lent'

  return (
    <Modal
      isOpen={isOpen}
      onClose={onClose}
      title={isLent ? 'تسجيل دفعة استرداد' : 'تسجيل دفعة سداد'}
    >
      {isOpen && (
        <PaymentFormContent
          key={debt.id}
          debt={debt}
          onClose={onClose}
          onSuccess={onSuccess}
        />
      )}
    </Modal>
  )
}
</file>

<file path="src/components/reports/SafeDailySpendCard.tsx">
import React from 'react'
import {
  ShieldCheck,
  AlertTriangle,
  AlertCircle,
  Calendar,
  Sparkles,
  ArrowDownRight,
} from 'lucide-react'
import { Card } from '../ui/Card'
import { useCurrency } from '../../hooks/useCurrency'
import type { ForecastResult } from '../../lib/forecast'
import { cn } from '../../lib/cn'

export interface SafeDailySpendCardProps {
  forecast: ForecastResult
  className?: string
}

export const SafeDailySpendCard: React.FC<SafeDailySpendCardProps> = ({
  forecast,
  className,
}) => {
  const { format } = useCurrency()

  const {
    dailySafeFils,
    actualDailySpendFils,
    healthStatus,
    remainingDays,
    freeBalance,
    upcomingRecurringExpenses,
    upcomingDebtObligations,
    isDeficitProjected,
    deficitAmount,
    surplusAmount,
    estimatedDeficitDay,
    recommendedDailyReductionFils,
    isCurrentMonth,
  } = forecast

  if (!isCurrentMonth) {
    return null
  }

  const totalUpcomingObligations = upcomingRecurringExpenses + upcomingDebtObligations

  return (
    <Card
      className={cn(
        'relative overflow-hidden border-2 transition-all',
        healthStatus === 'safe' &&
          'border-emerald-500/30 bg-gradient-to-br from-emerald-500/5 via-transparent to-transparent',
        healthStatus === 'warning' &&
          'border-amber-500/40 bg-gradient-to-br from-amber-500/5 via-transparent to-transparent',
        healthStatus === 'danger' &&
          'border-red-500/40 bg-gradient-to-br from-red-500/5 via-transparent to-transparent',
        className
      )}
    >
      {/* Header bar */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pb-4 border-b border-slate-100 dark:border-slate-800">
        <div className="flex items-center gap-2.5">
          <div
            className={cn(
              'w-9 h-9 rounded-xl flex items-center justify-center shrink-0',
              healthStatus === 'safe' && 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400',
              healthStatus === 'warning' && 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
              healthStatus === 'danger' && 'bg-red-500/10 text-red-600 dark:text-red-400'
            )}
          >
            {healthStatus === 'safe' && <ShieldCheck className="w-5 h-5" />}
            {healthStatus === 'warning' && <AlertTriangle className="w-5 h-5" />}
            {healthStatus === 'danger' && <AlertCircle className="w-5 h-5" />}
          </div>
          <div>
            <h3 className="text-base font-black text-slate-800 dark:text-slate-100">
              ميزانية الأمان اليومي وتوقّع الشهر
            </h3>
            <p className="text-xs text-slate-400 dark:text-slate-500">
              تحليل استباقي يراعي الفواتير المتكررة والديون القادمة
            </p>
          </div>
        </div>

        {/* Days remaining badge */}
