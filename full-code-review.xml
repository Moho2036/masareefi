<file path="src/context/AppDataContext.tsx">
/* eslint-disable react-refresh/only-export-components */
import {
  createContext,
  useContext,
  useEffect,
  useState,
  useCallback,
  useMemo,
  type ReactNode,
} from 'react'
import { useAuth } from '../hooks/useAuth'
import { subscribeUserSettings, updateUserSettings } from '../services/userProfile'
import { subscribeCategories } from '../services/categories'
import type { UserSettings, Category } from '../types'

export interface AppDataContextValue {
  settings: UserSettings | null
  settingsLoading: boolean
  settingsError: Error | null
  updateSettings: (partial: Partial<Omit<UserSettings, 'uid' | 'createdAt'>>) => Promise<void>
  categories: Category[]
  categoriesLoading: boolean
  categoriesError: Error | null
}

export const AppDataContext = createContext<AppDataContextValue | null>(null)

export function AppDataProvider({ children }: { children: ReactNode }) {
  const { user } = useAuth()
  const [settings, setSettings] = useState<UserSettings | null>(null)
  const [settingsLoading, setSettingsLoading] = useState(true)
  const [settingsError, setSettingsError] = useState<Error | null>(null)

  const [categories, setCategories] = useState<Category[]>([])
  const [categoriesLoading, setCategoriesLoading] = useState(true)
  const [categoriesError, setCategoriesError] = useState<Error | null>(null)

  useEffect(() => {
    if (!user) {
      return
    }

    // Deduplicated single listener for User Settings
    const unsubSettings = subscribeUserSettings(
      user.uid,
      (newSettings) => {
        setSettings(newSettings)
        setSettingsLoading(false)
      },
      (err) => {
        setSettingsError(err)
        setSettingsLoading(false)
      }
    )

    // Deduplicated single listener for Categories
    const unsubCategories = subscribeCategories(
      user.uid,
      (newCategories) => {
        setCategories(newCategories)
        setCategoriesLoading(false)
      },
      (err) => {
        setCategoriesError(err)
        setCategoriesLoading(false)
      }
    )

    return () => {
      unsubSettings()
      unsubCategories()
    }
  }, [user])

  const handleUpdateSettings = useCallback(
    async (partial: Partial<Omit<UserSettings, 'uid' | 'createdAt'>>): Promise<void> => {
      if (!user) throw new Error('No authenticated user')
      await updateUserSettings(user.uid, partial)
    },
    [user]
  )

  const value = useMemo<AppDataContextValue>(() => {
    if (!user) {
      return {
        settings: null,
        settingsLoading: false,
        settingsError: null,
        updateSettings: handleUpdateSettings,
        categories: [],
        categoriesLoading: false,
        categoriesError: null,
      }
    }

    return {
      settings,
      settingsLoading,
      settingsError,
      updateSettings: handleUpdateSettings,
      categories,
      categoriesLoading,
      categoriesError,
    }
  }, [
    user,
    settings,
    settingsLoading,
    settingsError,
    handleUpdateSettings,
    categories,
    categoriesLoading,
    categoriesError,
  ])

  return <AppDataContext.Provider value={value}>{children}</AppDataContext.Provider>
}

export function useAppData(): AppDataContextValue | null {
  return useContext(AppDataContext)
}
</file>

