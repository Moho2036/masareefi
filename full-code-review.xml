            <DebtCard
              key={debt.id}
              debt={debt}
              onOpenPaymentModal={(d) => setPaymentDebtId(d.id)}
              onOpenHistoryModal={(d) => setHistoryDebtId(d.id)}
              onEdit={handleEdit}
              onDelete={handleDelete}
            />
          ))}
        </div>
      )}

      {/* Form Modal (Add / Edit) */}
      <DebtFormModal
        isOpen={isFormOpen}
        onClose={() => {
          setIsFormOpen(false)
          setEditingDebt(null)
        }}
        initialDebt={editingDebt}
