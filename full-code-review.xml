import React, { useState, useMemo } from 'react'
import { Link } from 'react-router'
import { format as formatDate, addMonths } from 'date-fns'
import { ar } from 'date-fns/locale'
import {
  RefreshCw,
  Plus,
  Pencil,
  Trash2,
  Calendar,
  AlertCircle,
  Users,
  Zap,
} from 'lucide-react'
import { PageHeader } from '../components/layout/PageHeader'
import { Button } from '../components/ui/Button'
import { EmptyState } from '../components/ui/EmptyState'
import { Modal } from '../components/ui/Modal'
import { RecurringForm } from '../components/RecurringForm'
import { useAuth } from '../hooks/useAuth'
import { useCategories } from '../hooks/useCategories'
import { useRecurring } from '../hooks/useRecurring'
import { useMoneyCircles } from '../hooks/useMoneyCircles'
import { useCurrency } from '../hooks/useCurrency'
import { useToast } from '../hooks/useToast'
import { addRecurring, updateRecurring, deleteRecurring } from '../services/recurring'
import { getCurrentCircleMonth, isUserTurnMonth, updateMoneyCircle } from '../services/moneyCircles'
import { calculateMonthlyEquivalent, isOccurrenceSkipped } from '../lib/recurring'
import { toWesternDigits } from '../lib/dates'
import { cn } from '../lib/cn'
import type { Recurring, Frequency } from '../types'

export const RecurringPage: React.FC = () => {
  const { user } = useAuth()
  const { data: recurringItems, loading: recurringLoading } = useRecurring()
  const { data: categories } = useCategories()
  const { data: circles } = useMoneyCircles()
  const { format, formatWithSign } = useCurrency()
  const { showToast } = useToast()

  const [isFormOpen, setIsFormOpen] = useState(false)
  const [editingItem, setEditingItem] = useState<Recurring | null>(null)
  const [itemToDelete, setItemToDelete] = useState<Recurring | null>(null)
  const [deleting, setDeleting] = useState(false)

  const activeCircles = useMemo(() => circles.filter((c) => c.status === 'active'), [circles])

  // Map categoryId to Category
  const categoryMap = useMemo(() => {
    const map = new Map<string, (typeof categories)[0]>()
    for (const c of categories) {
      map.set(c.id, c)
    }
    return map
  }, [categories])

  // Monthly equivalents (waives turn month for circle recurring items)
  const monthlyStats = useMemo(() => {
    return calculateMonthlyEquivalent(recurringItems, new Date())
  }, [recurringItems])

  const handleScheduleCircle = async (circle: (typeof circles)[0]) => {
    if (!user) return
    const defaultExpenseCategory = categories.find((c) => c.type === 'expense' && !c.archived)
    if (!defaultExpenseCategory) {
      showToast('يرجى إنشاء تصنيف مصاريف أولاً', 'error')
      return
    }
    try {
      const recId = await addRecurring(user.uid, {
        type: 'expense',
        amountFils: circle.monthlyAmountFils,
        categoryId: defaultExpenseCategory.id,
        title: `قسط ${circle.name}`,
        note: `قسط شهري للجمعية - معفى من الخصم في شهر الاستلام (${circle.myTurnMonth})`,
        frequency: 'monthly',
        startDate: circle.startDate,
        nextDate: circle.startDate,
        endDate: addMonths(circle.startDate, circle.membersCount),
        active: true,
        circleId: circle.id,
        skipMonth: circle.myTurnMonth,
      })
      await updateMoneyCircle(user.uid, circle.id, { recurringId: recId })
      showToast('تمت جدولة القسط في المعاملات المتكررة بنجاح مع تخطي شهر استلامك!', 'success')
    } catch (err) {
      console.error('Failed to schedule circle:', err)
      showToast('تعذر جدولة القسط', 'error')
    }
  }

  const handleToggleActive = async (item: Recurring) => {
    if (!user) return
    const newActive = !item.active
    try {
      await updateRecurring(user.uid, item.id, { active: newActive })
      showToast(
        newActive
          ? 'تم تفعيل المعاملة المتكررة'
          : 'تم إيقاف المعاملة المتكررة مؤقتاً',
        'info'
      )
    } catch (err) {
      console.error('Failed to toggle recurring item:', err)
      showToast('تعذر تغيير حالة المعاملة', 'error')
    }
  }

  const handleDeleteConfirm = async () => {
    if (!user || !itemToDelete) return
    setDeleting(true)
    try {
      await deleteRecurring(user.uid, itemToDelete.id)
      showToast('تم حذف المعاملة المتكررة بنجاح', 'info')
      setItemToDelete(null)
    } catch (err) {
      console.error('Failed to delete recurring item:', err)
      showToast('تعذر حذف المعاملة', 'error')
    } finally {
      setDeleting(false)
    }
  }

  const frequencyLabels: Record<Frequency, string> = {
    weekly: 'أسبوعي',
    monthly: 'شهري',
    yearly: 'سنوي',
  }

  return (
    <div className="space-y-6 animate-slide-up">
      {/* Page Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <PageHeader
          title="المعاملات المتكررة"
          subtitle="جدولة المصاريف والمداخيل الدورية كالراتب والإيجار والاشتراكات"
        />
        <Button
          variant="primary"
          icon={<Plus className="w-4 h-4 stroke-[2.5]" />}
          onClick={() => {
            setEditingItem(null)
            setIsFormOpen(true)
          }}
          className="self-start sm:self-auto font-semibold"
        >
          إضافة متكررة
        </Button>
      </div>

      {/* KPI Cards: Monthly Income & Expense */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {/* Income Card */}
        <div className="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-400 dark:text-slate-500 block mb-1">
              مداخيل ثابتة شهرياً
            </span>
            <span className="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">
              {format(monthlyStats.monthlyIncome)}
            </span>
          </div>
          <div className="w-12 h-12 rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg">
            ↑
          </div>
        </div>

        {/* Expense Card */}
        <div className="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 shadow-xs flex items-center justify-between">
          <div>
            <span className="text-xs font-bold text-slate-400 dark:text-slate-500 block mb-1">
              مصاريف ثابتة شهرياً
            </span>
            <span className="text-2xl sm:text-3xl font-black text-red-500 dark:text-red-400">
              {format(monthlyStats.monthlyExpense)}
            </span>
          </div>
          <div className="w-12 h-12 rounded-2xl bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-lg">
            ↓
          </div>
        </div>
      </div>

      {/* Active Money Circles Section */}
      {activeCircles.length > 0 && (
        <div className="space-y-3">
          <div className="flex items-center justify-between">
            <h3 className="text-sm font-black text-slate-700 dark:text-slate-300 flex items-center gap-2">
              <Users className="w-4 h-4 text-emerald-500" />
              <span>أقساط الجمعيات والصناديق المشتركة</span>
            </h3>
            <Link
              to="/tools?tool=circles"
              className="text-xs font-bold text-emerald-600 dark:text-emerald-400 hover:underline"
            >
              إدارة الجمعيات ←
            </Link>
          </div>

          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {activeCircles.map((circle) => {
              const isUserTurn = isUserTurnMonth(circle)
              const currentMonth = getCurrentCircleMonth(circle)
              return (
                <div
                  key={circle.id}
                  className={cn(
                    'p-4 rounded-2xl border transition-all flex flex-col justify-between',
                    isUserTurn
                      ? 'bg-emerald-50/70 dark:bg-emerald-950/30 border-emerald-300 dark:border-emerald-800'
                      : 'bg-white dark:bg-slate-800 border-slate-200/80 dark:border-slate-700'
                  )}
                >
                  <div className="flex items-center justify-between mb-2">
                    <span className="font-bold text-sm text-slate-800 dark:text-slate-100">
                      {circle.name}
                    </span>
                    {isUserTurn ? (
                      <span className="text-[10px] font-black px-2 py-0.5 rounded-full bg-emerald-500 text-white">
                        👑 دورك في الاستلام!
                      </span>
                    ) : (
                      <span className="text-[11px] font-semibold text-slate-400">
                        الشهر {currentMonth} من {circle.membersCount}
                      </span>
                    )}
                  </div>

                  <div className="flex items-center justify-between text-xs">
                    <span className="text-slate-500 dark:text-slate-400">
                      {isUserTurn ? 'مبلغ الاستلام الإجمالي:' : 'القسط الشهري المطلوب:'}
                    </span>
                    <span
                      className={cn(
                        'font-black text-sm',
                        isUserTurn
                          ? 'text-emerald-600 dark:text-emerald-400'
                          : 'text-red-500 dark:text-red-400'
                      )}
                    >
                      {isUserTurn
                        ? `+ ${format(circle.totalAmountFils)}`
                        : `- ${format(circle.monthlyAmountFils)}`}
                    </span>
                  </div>

                  {isUserTurn && (
                    <p className="text-[10px] text-emerald-700 dark:text-emerald-300 mt-2 font-medium">
                      ✓ لن يتم خصم قسط منك هذا الشهر لأنك مستلم الجمعية!
                    </p>
                  )}

                  {/* Recurring Schedule Link / Status */}
                  <div className="mt-3 pt-2 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs">
                    {circle.recurringId ? (
                      <span className="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-1">
                        <Zap className="w-3 h-3 text-emerald-500 shrink-0" />
                        <span>مجدولة بالمعاملات</span>
                      </span>
                    ) : (
                      <button
                        type="button"
                        onClick={() => handleScheduleCircle(circle)}
                        className="text-xs text-emerald-600 dark:text-emerald-400 font-bold hover:underline flex items-center gap-1 cursor-pointer"
                      >
                        <Zap className="w-3 h-3 text-amber-500 shrink-0" />
                        <span>جدولة القسط شهرياً</span>
                      </button>
                    )}
                    {isUserTurn && (
                      <span className="text-[10px] text-emerald-600 dark:text-emerald-400 font-bold">معفى من الخصم</span>
                    )}
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      )}

      {/* Recurring Items Grid */}
      {recurringLoading ? (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {[1, 2, 3].map((i) => (
            <div
              key={i}
              className="h-44 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700/60 animate-pulse"
            />
          ))}
        </div>
      ) : recurringItems.length === 0 ? (
        <EmptyState
          icon={<RefreshCw className="w-8 h-8" />}
          title="لا توجد معاملات متكررة"
          description="أضف التزاماتك الثابتة (رواتب، إيجار، اشتراكات) ليقوم التطبيق بتسجيلها تلقائياً عند حلول موعدها."
          action={
            <Button
              variant="primary"
              size="md"
              icon={<Plus className="w-4 h-4 stroke-[2.5]" />}
              onClick={() => {
                setEditingItem(null)
                setIsFormOpen(true)
              }}
            >
              إضافة أول معاملة متكررة
            </Button>
          }
        />
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {recurringItems.map((item) => {
            const cat = categoryMap.get(item.categoryId)
            const icon = cat?.icon ?? '➕'
            const color = cat?.color ?? '#94A3B8'
            const name = cat?.name ?? 'غير مصنف'
            const isExpense = item.type === 'expense'
            const isCircleItem = Boolean(item.circleId || item.skipMonth)
            const isCurrentMonthTurn = isCircleItem && isOccurrenceSkipped(item, new Date())

            const nextDateFormatted = toWesternDigits(
              formatDate(
                item.nextDate instanceof Date ? item.nextDate : new Date(item.nextDate),
                'd LLLL yyyy',
                { locale: ar }
              )
            )

            return (
              <div
                key={item.id}
                className={cn(
                  'group rounded-2xl p-5 border transition-all flex flex-col justify-between',
                  item.active
                    ? 'bg-white dark:bg-slate-800 border-slate-200/80 dark:border-slate-700/60 shadow-xs hover:shadow-md'
                    : 'bg-slate-100/70 dark:bg-slate-800/40 border-slate-200 dark:border-slate-800 opacity-75'
                )}
              >
                {/* Top Row: Category + Frequency Badge */}
                <div className="flex items-start justify-between gap-3 mb-3">
                  <div className="flex items-center gap-3 min-w-0">
                    <div
                      className="w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0"
                      style={{ backgroundColor: `${color}25` }}
                    >
                      {icon}
                    </div>
                    <div className="min-w-0">
                      <span className="font-bold text-sm text-slate-800 dark:text-slate-100 block truncate">
                        {item.title || name}
                      </span>
                      <div className="flex items-center gap-1.5 text-xs text-slate-400 dark:text-slate-400 truncate mt-0.5">
                        {item.title ? (
                          <>
                            <span className="font-medium text-slate-500 dark:text-slate-400">{name}</span>
                            {item.note ? <span>•</span> : null}
                          </>
                        ) : null}
                        {item.note ? <span>{item.note}</span> : null}
                      </div>
                    </div>
                  </div>

                  <div className="flex items-center gap-1.5 shrink-0">
                    {!item.active && (
                      <span className="text-xs px-2 py-0.5 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold">
                        متوقفة مؤقتاً
                      </span>
                    )}
                    <span className="text-xs px-2.5 py-1 rounded-xl bg-amber-50 dark:bg-amber-950/40 text-amber-700 dark:text-amber-400 font-bold border border-amber-200/60 dark:border-amber-900/40">
                      {frequencyLabels[item.frequency]}
                    </span>
                  </div>
                </div>

                {/* Circle Skip Month Indicator */}
                {isCircleItem && (
                  <div className="my-1.5">
                    {isCurrentMonthTurn ? (
                      <div className="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-xs font-bold text-emerald-800 dark:text-emerald-300 flex items-center justify-between">
                        <span>👑 دورك في الاستلام هذا الشهر!</span>
                        <span className="text-[10px] bg-emerald-500 text-white px-2 py-0.5 rounded-full font-black">
                          معفى من الخصم تلقائياً
                        </span>
                      </div>
                    ) : item.skipMonth ? (
                      <div className="flex items-center gap-1 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400">
                        <Zap className="w-3 h-3 text-emerald-500 shrink-0" />
                        <span>قسط جمعية (معفى من الخصم في الشهر رقم {item.skipMonth})</span>
                      </div>
                    ) : null}
                  </div>
                )}

                {/* Middle: Amount in large bold text */}
                <div className="my-2">
                  <div
                    className={cn(
                      'text-xl sm:text-2xl font-black select-none',
                      isExpense
                        ? 'text-red-500 dark:text-red-400'
                        : 'text-emerald-600 dark:text-emerald-400'
                    )}
                  >
                    {formatWithSign(item.amountFils, item.type)}
                  </div>
                </div>

                {/* Bottom Row: Next date, Active toggle, Actions */}
                <div className="pt-3 border-t border-slate-100 dark:border-slate-700/60 flex items-center justify-between gap-2 text-xs">
                  <div className="flex items-center gap-1 text-slate-400 dark:text-slate-400 truncate">
                    <Calendar className="w-3.5 h-3.5 shrink-0" />
                    <span className="truncate">الموعد القادم: {nextDateFormatted}</span>
                  </div>

                  <div className="flex items-center gap-1 shrink-0">
                    {/* Toggle button */}
                    <button
                      type="button"
                      onClick={() => handleToggleActive(item)}
                      role="switch"
                      aria-checked={item.active}
                      aria-label={item.active ? 'إيقاف مؤقت' : 'تفعيل'}
                      className={cn(
                        'w-9 h-5 rounded-full transition-colors relative cursor-pointer',
                        item.active
                          ? 'bg-emerald-500 dark:bg-emerald-600'
                          : 'bg-slate-300 dark:bg-slate-600'
                      )}
                    >
                      <span
                        className={cn(
                          'w-3.5 h-3.5 bg-white rounded-full absolute top-0.5 transition-transform shadow-xs',
                          item.active ? 'end-0.5' : 'start-0.5'
                        )}
                      />
                    </button>

                    {/* Edit button */}
                    <button
                      type="button"
                      onClick={() => {
                        setEditingItem(item)
                        setIsFormOpen(true)
                      }}
                      className="p-1 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 dark:hover:text-slate-200 dark:hover:bg-slate-700 transition-colors cursor-pointer"
                      aria-label="تعديل المعاملة المتكررة"
                    >
                      <Pencil className="w-3.5 h-3.5" />
                    </button>

                    {/* Delete button */}
                    <button
                      type="button"
                      onClick={() => setItemToDelete(item)}
                      className="p-1 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 dark:hover:text-red-400 dark:hover:bg-red-950/40 transition-colors cursor-pointer"
                      aria-label="حذف المعاملة المتكررة"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                </div>
              </div>
            )
          })}
        </div>
      )}

      {/* Recurring Form Modal */}
      <RecurringForm
        isOpen={isFormOpen}
        onClose={() => setIsFormOpen(false)}
        initialRecurring={editingItem}
      />

      {/* Delete Confirmation Modal */}
      <Modal
        isOpen={Boolean(itemToDelete)}
        onClose={() => setItemToDelete(null)}
        title="تأكيد حذف المعاملة المتكررة"
      >
        <div className="space-y-4">
          <div className="flex items-center gap-3 text-red-600 dark:text-red-400">
            <AlertCircle className="w-5 h-5 shrink-0" />
            <p className="text-sm font-semibold">
              هل أنت متأكد من حذف هذه المعاملة المتكررة؟ لن يتم إنشاء أي معاملات مستقبلية منها.
            </p>
          </div>
          <div className="flex items-center justify-end gap-2 pt-2">
            <Button
              variant="outline"
              size="md"
              onClick={() => setItemToDelete(null)}
              disabled={deleting}
            >
              إلغاء
            </Button>
            <Button
              variant="danger"
              size="md"
              onClick={handleDeleteConfirm}
              disabled={deleting}
            >
              {deleting ? 'جاري الحذف...' : 'حذف المعاملة المتكررة'}
            </Button>
          </div>
        </div>
      </Modal>
    </div>
  )
}
</file>

<file path="src/pages/SettingsPage.tsx">
import React, { useState } from 'react'
import {
  Sun,
  Moon,
  Laptop,
  Coins,
  LogOut,
  Download,
  CheckCircle2,
  FileSpreadsheet,
} from 'lucide-react'
import { PageHeader } from '../components/layout/PageHeader'
import { Card } from '../components/ui/Card'
import { SegmentedControl } from '../components/ui/SegmentedControl'
import { Select } from '../components/ui/Select'
import { Button } from '../components/ui/Button'
import { Input } from '../components/ui/Input'
import { useTheme } from '../hooks/useTheme'
import { useAuth } from '../hooks/useAuth'
import { useUserSettings } from '../hooks/useUserSettings'
import { useCategories } from '../hooks/useCategories'
import { useToast } from '../hooks/useToast'
import { usePWAInstall } from '../hooks/usePWAInstall'
import { signOutUser } from '../services/auth'
import { getAllTransactions } from '../services/transactions'
import { getAllDebts } from '../services/debts'
import { exportTransactionsToCsv, exportDebtsToCsv } from '../lib/exportCsv'
import { PRESET_CURRENCIES, getCurrencyConfig } from '../lib/money'
import { cn } from '../lib/cn'
import type { ThemePreference } from '../types'

export const SettingsPage: React.FC = () => {
  const { theme, setTheme, resolvedTheme } = useTheme()
  const { user } = useAuth()
  const { data: settings, updateSettings } = useUserSettings()
  const { data: categories } = useCategories()
  const { showToast } = useToast()
  const { isInstallable, isInstalled, promptInstall } = usePWAInstall()

  const [selectedDay, setSelectedDay] = useState<string | null>(null)
  const [loggingOut, setLoggingOut] = useState(false)
  const [exportingTxs, setExportingTxs] = useState(false)
  const [exportingDebts, setExportingDebts] = useState(false)

  const activeCurrency = settings?.currency || 'JOD'
  const isPreset = Boolean(PRESET_CURRENCIES[activeCurrency])
  const [isCustomCurrency, setIsCustomCurrency] = useState(!isPreset && activeCurrency !== 'JOD')
  const [customCurrencyInput, setCustomCurrencyInput] = useState(isPreset ? '' : activeCurrency)
  const [savingCurrency, setSavingCurrency] = useState(false)

  const activeConfig = getCurrencyConfig(activeCurrency)

  const handleSelectPreset = async (code: string) => {
    setIsCustomCurrency(false)
    try {
      await updateSettings({ currency: code })
      showToast(`تم تغيير العملة إلى ${PRESET_CURRENCIES[code]?.name || code} بنجاح`, 'success')
    } catch (err) {
      console.error('Failed to update currency:', err)
      showToast('تعذر تغيير العملة', 'error')
    }
  }

  const handleSaveCustomCurrency = async () => {
    const trimmed = customCurrencyInput.trim()
    if (!trimmed) return
    setSavingCurrency(true)
    try {
      await updateSettings({ currency: trimmed })
      showToast(`تم تعيين العملة المخصصة: ${trimmed}`, 'success')
    } catch (err) {
      console.error('Failed to save custom currency:', err)
      showToast('تعذر حفظ العملة المخصصة', 'error')
    } finally {
      setSavingCurrency(false)
    }
  }

  const currentStartDay =
    selectedDay ?? (settings?.monthStartDay ? String(settings.monthStartDay) : '1')

  const themeOptions: { value: ThemePreference; label: string; icon: React.ReactNode }[] = [
    { value: 'system', label: 'تلقائي', icon: <Laptop className="w-4 h-4" /> },
    { value: 'light', label: 'فاتح', icon: <Sun className="w-4 h-4" /> },
    { value: 'dark', label: 'داكن', icon: <Moon className="w-4 h-4" /> },
  ]

  const dayOptions = Array.from({ length: 28 }, (_, i) => ({
    value: String(i + 1),
    label: `يوم ${i + 1} من كل شهر`,
  }))

  const handleThemeChange = async (newTheme: ThemePreference) => {
    setTheme(newTheme)
    try {
      await updateSettings({ theme: newTheme })
    } catch (err) {
      console.error('Failed to persist theme:', err)
    }
  }

  const handleStartDayChange = async (e: React.ChangeEvent<HTMLSelectElement>) => {
    const val = e.target.value
    setSelectedDay(val)
    try {
      await updateSettings({ monthStartDay: parseInt(val, 10) })
    } catch (err) {
      console.error('Failed to persist month start day:', err)
    }
  }

  const handleSignOut = async () => {
    setLoggingOut(true)
    try {
      await signOutUser()
    } catch (err) {
      console.error('Failed to sign out:', err)
    } finally {
      setLoggingOut(false)
    }
  }

  const handleExportTransactions = async () => {
    if (!user) return
    setExportingTxs(true)
    try {
      const txs = await getAllTransactions(user.uid)
      if (txs.length === 0) {
        showToast('لا توجد أي معاملات لتصديرها', 'info')
        return
      }
      exportTransactionsToCsv(txs, categories, {
        symbol: activeConfig.symbol,
        decimals: activeConfig.decimals,
      })
      showToast('تم تصدير المعاملات بنجاح', 'success')
    } catch (err) {
      console.error('Failed to export transactions:', err)
      showToast('تعذر تصدير المعاملات', 'error')
    } finally {
      setExportingTxs(false)
    }
  }

  const handleExportDebts = async () => {
    if (!user) return
    setExportingDebts(true)
    try {
      const debts = await getAllDebts(user.uid)
      if (debts.length === 0) {
        showToast('لا توجد أي ديون لتصديرها', 'info')
        return
      }
      exportDebtsToCsv(debts, {
        symbol: activeConfig.symbol,
        decimals: activeConfig.decimals,
      })
      showToast('تم تصدير سجل الديون بنجاح', 'success')
    } catch (err) {
      console.error('Failed to export debts:', err)
      showToast('تعذر تصدير سجل الديون', 'error')
    } finally {
      setExportingDebts(false)
    }
  }

  return (
    <div className="space-y-6 max-w-3xl">
      <PageHeader
        title="الإعدادات"
        subtitle="تفضيلات المظهر، بداية الشهر المالي، وإدارة الحساب"
      />

      {/* Theme Settings Card */}
      <Card
        title="المظهر والألوان"
        subtitle="اختر المظهر المفضل للتطبيق أو دعه يتبع إعدادات جهازك"
      >
        <div className="space-y-4 pt-2">
          <SegmentedControl<ThemePreference>
            value={theme}
            onChange={handleThemeChange}
            options={themeOptions}
            className="w-full sm:w-auto"
          />

          <p className="text-xs text-slate-500 dark:text-slate-400">
            الوضع الحالي النشط:{' '}
            <span className="font-semibold text-emerald-600 dark:text-emerald-400">
              {resolvedTheme === 'dark' ? 'داكن' : 'فاتح'}
            </span>{' '}
            {theme === 'system' && '(تلقائي حسب النظام)'}
          </p>
        </div>
      </Card>

      {/* Financial Month Start Day */}
      <Card
        title="بداية الشهر المالي"
        subtitle="حدد اليوم الذي يبدأ فيه حساب دخلك ومصاريفك (مثلاً يوم استلام الراتب)"
      >
        <div className="pt-2 max-w-xs">
          <Select
            label="يوم بداية الدورة المالية"
            value={currentStartDay}
            onChange={handleStartDayChange}
            options={dayOptions}
            helperText="الافتراضي هو اليوم الأول من كل شهر (1 إلى 28)."
          />
        </div>
      </Card>

      {/* Currency Selection Card */}
      <Card
        title="العملة الرسمية"
        subtitle="اختر العملة المعتمدة في حساباتك وشاشات التطبيق"
      >
        <div className="space-y-4 pt-2">
          {/* Preset Buttons Grid */}
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
            {Object.values(PRESET_CURRENCIES).map((curr) => {
              const isSelected = !isCustomCurrency && activeCurrency === curr.code
              return (
                <button
                  key={curr.code}
                  type="button"
                  onClick={() => handleSelectPreset(curr.code)}
                  className={cn(
                    'flex items-center gap-2.5 p-3 rounded-xl border text-start transition-all cursor-pointer',
                    isSelected
                      ? 'border-emerald-500 bg-emerald-50/70 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 ring-2 ring-emerald-500/20'
                      : 'border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'
                  )}
                >
                  <span className="text-xl select-none">{curr.flag}</span>
                  <div className="min-w-0 flex-1">
                    <div className="text-xs font-bold truncate">{curr.name}</div>
                    <div className="text-[11px] text-slate-400 dark:text-slate-500 font-medium">
                      {curr.code} ({curr.symbol})
                    </div>
                  </div>
                </button>
              )
            })}

            {/* Custom Currency Option */}
            <button
              type="button"
              onClick={() => setIsCustomCurrency(true)}
              className={cn(
                'flex items-center gap-2.5 p-3 rounded-xl border text-start transition-all cursor-pointer',
                isCustomCurrency
                  ? 'border-emerald-500 bg-emerald-50/70 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 ring-2 ring-emerald-500/20'
                  : 'border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300'
              )}
            >
              <span className="text-xl select-none">✏️</span>
              <div className="min-w-0 flex-1">
                <div className="text-xs font-bold truncate">عملة أخرى</div>
                <div className="text-[11px] text-slate-400 dark:text-slate-500 font-medium truncate">
                  {isCustomCurrency && customCurrencyInput ? customCurrencyInput : 'تحديد يدوي'}
                </div>
              </div>
            </button>
          </div>

          {/* Custom Currency Input */}
          {isCustomCurrency && (
            <div className="p-3.5 rounded-xl border border-dashed border-emerald-300 dark:border-emerald-800/70 bg-emerald-50/40 dark:bg-emerald-950/20 space-y-3">
              <div className="flex flex-col sm:flex-row gap-2.5 items-end">
                <div className="flex-1 w-full">
                  <Input
                    label="رمز أو اسم العملة المخصصة"
                    placeholder="مثال: ج.م أو د.ك أو QAR أو ليرة"
                    value={customCurrencyInput}
                    onChange={(e) => setCustomCurrencyInput(e.target.value)}
                    maxLength={20}
                    helperText="سيظهر هذا الرمز بجانب جميع المبالغ المالية في التطبيق."
                  />
                </div>
                <Button
                  onClick={handleSaveCustomCurrency}
                  disabled={!customCurrencyInput.trim() || savingCurrency}
                  variant="primary"
                  className="w-full sm:w-auto"
                >
                  {savingCurrency ? 'جاري الحفظ...' : 'تطبيق العملة'}
                </Button>
              </div>
            </div>
          )}

          <div className="flex items-center gap-2 pt-1 text-xs text-slate-500 dark:text-slate-400">
            <Coins className="w-4 h-4 text-emerald-500 shrink-0" />
            <span>
              العملة النشطة الحالية:{' '}
              <span className="font-bold text-emerald-600 dark:text-emerald-400">
                {activeConfig.name} ({activeConfig.symbol})
              </span>
            </span>
          </div>
        </div>
      </Card>

      {/* PWA App Installation Card */}
      <Card
        title="تثبيت التطبيق (PWA)"
        subtitle="يمكنك تثبيت تطبيق مصاريفي على هاتفك أو حاسوبك للعمل بدون إنترنت وسرعة فائقة"
      >
        <div className="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
              <Download className="w-5 h-5" />
            </div>
            <div>
              <div className="text-sm font-bold text-slate-800 dark:text-slate-200">
                {isInstalled ? 'التطبيق مثبت حالياً' : 'تطبيق ويب تقدمي (PWA)'}
              </div>
              <div className="text-xs text-slate-400">
                {isInstalled
                  ? 'يعمل التطبيق كبرنامج مستقل مع دعم كامل للعمل بلا اتصال'
                  : 'يعمل بكامل ميزاته مباشرة من الشاشة الرئيسية دون الحاجة للمتجر'}
              </div>
            </div>
          </div>

          {isInstalled ? (
            <div className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 text-xs font-bold">
              <CheckCircle2 className="w-4 h-4" />
              <span>مثبت على الجهاز</span>
            </div>
          ) : isInstallable ? (
            <Button
              variant="primary"
              size="sm"
              icon={<Download className="w-4 h-4" />}
              onClick={promptInstall}
            >
              تثبيت التطبيق على جهازك
            </Button>
          ) : (
            <span className="text-xs text-slate-400 font-medium">
              متاح للتثبيت من متصفحك عبر زر المشاركة أو القائمة
            </span>
          )}
        </div>
      </Card>

      {/* Data Export & Backup Card */}
      <Card
        title="تصدير البيانات والنسخ الاحتياطي"
        subtitle="تصدير بياناتك المالية وسجلات الديون إلى ملفات Excel/CSV تدعم اللغة العربية"
      >
        <div className="pt-2 space-y-4">
          <p className="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            يمكنك تنزيل نسخة احتياطية من معاملاتك المالية وسجل الديون بتنسيق CSV يدعم الترميز العربي الكامل (UTF-8 BOM) لفتحه مباشرة في Microsoft Excel وجداول بيانات Google.
          </p>

          <div className="flex flex-col sm:flex-row gap-3">
            <Button
              variant="outline"
              size="md"
              icon={<FileSpreadsheet className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />}
              onClick={handleExportTransactions}
              disabled={exportingTxs || !user}
              className="flex-1 font-bold"
            >
              {exportingTxs ? 'جاري التصدير...' : 'تصدير جميع المعاملات (CSV)'}
            </Button>

            <Button
              variant="outline"
              size="md"
              icon={<FileSpreadsheet className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />}
              onClick={handleExportDebts}
              disabled={exportingDebts || !user}
              className="flex-1 font-bold"
            >
              {exportingDebts ? 'جاري التصدير...' : 'تصدير سجل الديون (CSV)'}
            </Button>
          </div>
        </div>
      </Card>

      {/* Account Info */}
      <Card title="الحساب الشخصي" subtitle="معلومات تسجيل الدخول عبر Google">
        <div className="pt-2 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div className="flex items-center gap-3">
            {user?.photoURL ? (
              <img
                src={user.photoURL}
                alt={user.displayName || 'صورة المستخدم'}
                className="w-10 h-10 rounded-full object-cover border border-slate-200 dark:border-slate-700"
                referrerPolicy="no-referrer"
              />
            ) : (
              <div className="w-10 h-10 rounded-full bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-200 flex items-center justify-center font-bold">
                {user?.displayName ? user.displayName.charAt(0) : 'م'}
              </div>
            )}
            <div>
              <div className="text-sm font-bold text-slate-800 dark:text-slate-200">
                {user?.displayName || 'مستخدم مصاريفي'}
              </div>
              <div className="text-xs text-slate-400" dir="ltr">
                {user?.email || 'بدون بريد إلكتروني'}
              </div>
            </div>
          </div>

          <Button
            variant="outline"
            size="sm"
            icon={<LogOut className="w-4 h-4 rtl:rotate-180" />}
            onClick={handleSignOut}
            disabled={loggingOut}
          >
            {loggingOut ? 'جاري الخروج...' : 'تسجيل الخروج'}
          </Button>
        </div>
      </Card>
    </div>
  )
}
</file>

<file path="src/pages/TransactionsPage.tsx">
import React, { useState, useMemo } from 'react'
import {
  ArrowLeftRight,
  Search,
  Plus,
  Pencil,
  Trash2,
  Calendar,
  HandCoins,
  Copy,
  X,
} from 'lucide-react'
import { PageHeader } from '../components/layout/PageHeader'
import { SegmentedControl } from '../components/ui/SegmentedControl'
import { EmptyState } from '../components/ui/EmptyState'
import { Button } from '../components/ui/Button'
import { Modal } from '../components/ui/Modal'
import { useAuth } from '../hooks/useAuth'
import { useCategories } from '../hooks/useCategories'
import { useTransactions } from '../hooks/useTransactions'
import { useSelectedMonth } from '../hooks/useSelectedMonth'
import { useTransactionModal } from '../hooks/useTransactionModal'
import { useToast } from '../hooks/useToast'
import { useCurrency } from '../hooks/useCurrency'
import { deleteTransaction } from '../services/transactions'
import { formatDayHeader } from '../lib/dates'
import {
  getCategoryUsageMap,
  sortCategoriesByUsage,
  buildUsageFromTransactions,
  mergeAndSaveUsage,
} from '../lib/categoryUsage'
import { filterTransactions, sumByType, groupByDay } from '../lib/aggregate'
import { cn } from '../lib/cn'
import type { Transaction, TxType } from '../types'

export const TransactionsPage: React.FC = () => {
  const { user } = useAuth()
  const { range } = useSelectedMonth()
  const { data: rawTransactions, loading: txLoading } = useTransactions(range)
  const { data: categories } = useCategories()
  const { openAdd, openEdit, openDuplicate } = useTransactionModal()
  const { showToast } = useToast()
  const { format, formatWithSign } = useCurrency()

  const [query, setQuery] = useState('')
  const [filterType, setFilterType] = useState<TxType | 'all'>('all')
  const [selectedCategory, setSelectedCategory] = useState<string>('all')
  const [txToDelete, setTxToDelete] = useState<Transaction | null>(null)
  const [deleting, setDeleting] = useState(false)

  const isFilterActive = Boolean(
    query.trim() || filterType !== 'all' || selectedCategory !== 'all'
  )

  const handleResetFilters = () => {
    setQuery('')
    setFilterType('all')
    setSelectedCategory('all')
  }

  // Map categoryId to Category for O(1) lookups
  const categoryMap = useMemo(() => {
    const map = new Map<string, (typeof categories)[0]>()
    for (const c of categories) {
      map.set(c.id, c)
    }
    return map
  }, [categories])

  // Track category usage from transactions to surface most used categories first
  const usageMap = useMemo(() => {
    const txMap = buildUsageFromTransactions(rawTransactions)
    return mergeAndSaveUsage(txMap, getCategoryUsageMap())
  }, [rawTransactions])

  // Relevant categories for horizontal chips (sorted by usage frequency)
  const relevantCategories = useMemo(() => {
    const filtered = categories.filter(
      (c) => (filterType === 'all' ? true : c.type === filterType) && !c.archived
    )
    return sortCategoriesByUsage(filtered, usageMap)
  }, [categories, filterType, usageMap])

  // Filtered transactions
  const filteredTransactions = useMemo(() => {
    return filterTransactions(rawTransactions, {
      query,
      type: filterType,
      categoryId: selectedCategory,
    })
  }, [rawTransactions, query, filterType, selectedCategory])

  // Summary totals for filtered set
  const totals = useMemo(() => {
    return sumByType(filteredTransactions)
  }, [filteredTransactions])

  // Grouped by day
  const today = useMemo(() => new Date(), [])
  const dayGroups = useMemo(() => {
    return groupByDay(filteredTransactions)
  }, [filteredTransactions])

  const handleDeleteConfirm = async () => {
    if (!user || !txToDelete) return
    setDeleting(true)
    try {
      await deleteTransaction(user.uid, txToDelete.id)
      showToast('تم حذف المعاملة بنجاح', 'info')
      setTxToDelete(null)
    } catch (err) {
      console.error('Failed to delete transaction:', err)
      showToast('تعذر حذف المعاملة', 'error')
    } finally {
      setDeleting(false)
    }
  }

  return (
    <div className="space-y-6 animate-slide-up">
      {/* Page Header */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <PageHeader
          title="المعاملات"
          subtitle="سجل كامل بجميع المصاريف والمداخيل وتفاصيلها"
        />
        <Button
          variant="primary"
          icon={<Plus className="w-4 h-4 stroke-[2.5]" />}
          onClick={() => openAdd('expense')}
          className="hidden lg:inline-flex self-start sm:self-auto font-semibold"
        >
          إضافة معاملة
        </Button>
      </div>

      {/* 2-Column Responsive Layout on Desktop (Filters/Totals in Sticky Sidebar, Transactions in Main) */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        {/* Sidebar Column: Filter Bar & Monthly Totals */}
        <aside className="lg:col-span-4 space-y-3.5 lg:sticky lg:top-20">
          {/* Filter Bar */}
          <div className="bg-white dark:bg-slate-800 p-3 sm:p-3.5 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 shadow-xs space-y-2.5">
            {/* Top Row: Search Input & Type Toggle */}
            <div className="flex flex-col items-stretch gap-2">
              {/* Search Input */}
              <div className="relative">
                <div className="absolute inset-y-0 start-0 ps-3.5 flex items-center pointer-events-none text-slate-400">
                  <Search className="w-4 h-4" />
                </div>
                <input
                  type="text"
                  value={query}
                  onChange={(e) => setQuery(e.target.value)}
                  placeholder="ابحث في العنوان أو الملاحظات..."
                  className="w-full ps-10 pe-3.5 py-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 text-slate-800 dark:text-slate-100 placeholder:text-slate-400 text-xs sm:text-sm focus:outline-none focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20 transition-all"
                />
              </div>

              {/* Type Toggle: الكل / مصاريف / مداخيل */}
              <SegmentedControl<TxType | 'all'>
                value={filterType}
                onChange={(val) => {
                  setFilterType(val)
                  setSelectedCategory('all')
                }}
                options={[
                  { value: 'all', label: 'الكل' },
                  { value: 'expense', label: 'مصاريف' },
                  { value: 'income', label: 'مداخيل' },
                ]}
              />
            </div>

            {/* Bottom Row: Horizontal Scrollable Category Chips */}
            <div className="flex items-center gap-1.5 overflow-x-auto pb-1 pt-0.5 select-none text-xs">
              {/* All Categories Chip */}
              <button
                type="button"
                onClick={() => setSelectedCategory('all')}
                className={cn(
                  'px-3 py-1.5 rounded-xl font-semibold whitespace-nowrap transition-all shrink-0 cursor-pointer',
                  selectedCategory === 'all'
                    ? 'bg-emerald-500 text-white shadow-xs font-bold'
                    : 'bg-slate-100 dark:bg-slate-750 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-700'
                )}
              >
                كل التصنيفات
              </button>

              {/* Individual Category Chips */}
              {relevantCategories.map((cat) => {
                const isSelected = selectedCategory === cat.id
                return (
                  <button
                    key={cat.id}
                    type="button"
                    onClick={() => setSelectedCategory(isSelected ? 'all' : cat.id)}
                    className={cn(
                      'flex items-center gap-1.5 px-3 py-1.5 rounded-xl whitespace-nowrap transition-all shrink-0 cursor-pointer',
                      isSelected
                        ? 'bg-emerald-500 text-white shadow-xs font-bold'
                        : 'bg-slate-100 dark:bg-slate-750 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-slate-700'
                    )}
                  >
                    <span className="text-sm shrink-0">{cat.icon}</span>
                    <span className="font-semibold">{cat.name}</span>
                  </button>
                )
              })}
            </div>
          </div>

          {/* Active Filter & Search Summary Strip */}
          {isFilterActive && (
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 px-3.5 py-2.5 bg-emerald-50/70 dark:bg-emerald-950/40 border border-emerald-200/80 dark:border-emerald-800/60 rounded-2xl text-xs shadow-xs">
              <div className="flex items-center gap-2 flex-wrap">
                <span className="inline-flex items-center gap-1.5 font-bold text-emerald-900 dark:text-emerald-200">
                  <Search className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
                  <span>النتائج:</span>
                  <span className="px-1.5 py-0.5 rounded-lg bg-emerald-100 dark:bg-emerald-900/60 text-emerald-800 dark:text-emerald-300 font-black">
                    {filteredTransactions.length}
                  </span>
                </span>

                <span className="text-emerald-300 dark:text-emerald-700">•</span>

                <div className="flex items-center gap-1.5 flex-wrap font-medium text-slate-700 dark:text-slate-300">
                  <span>المجموع:</span>
                  {filterType === 'expense' ? (
                    <span className="font-black text-red-600 dark:text-red-400">
                      {format(totals.expense)}
                    </span>
                  ) : filterType === 'income' ? (
                    <span className="font-black text-emerald-600 dark:text-emerald-400">
                      {format(totals.income)}
                    </span>
                  ) : (
                    <div className="flex items-center gap-1.5">
                      <span className="text-red-600 dark:text-red-400 font-bold">
                        -{format(totals.expense)}
                      </span>
                      <span className="text-slate-300 dark:text-slate-600">/</span>
                      <span className="text-emerald-600 dark:text-emerald-400 font-bold">
                        +{format(totals.income)}
                      </span>
                    </div>
                  )}
                </div>
              </div>

              <button
                type="button"
                onClick={handleResetFilters}
                className="self-end sm:self-auto text-xs font-bold text-emerald-700 dark:text-emerald-300 hover:text-emerald-800 dark:hover:text-emerald-100 hover:underline inline-flex items-center gap-1 cursor-pointer"
              >
                <span>مسح</span>
                <X className="w-3.5 h-3.5" />
              </button>
            </div>
          )}

          {/* Monthly Totals Strip Card */}
          <div className="grid grid-cols-2 gap-3 bg-white dark:bg-slate-800 p-3.5 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 shadow-xs">
            <div className="flex items-center gap-2.5">
              <div className="w-9 h-9 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm">
                ↑
              </div>
              <div className="min-w-0">
                <div className="text-[11px] font-semibold text-slate-400 truncate">إجمالي المداخيل</div>
                <div className="text-sm sm:text-base font-black text-emerald-600 dark:text-emerald-400 truncate">
                  {format(totals.income)}
                </div>
              </div>
            </div>

            <div className="flex items-center gap-2.5 border-s border-slate-100 dark:border-slate-700 ps-3">
              <div className="w-9 h-9 rounded-xl bg-red-50 dark:bg-red-950/40 text-red-600 dark:text-red-400 flex items-center justify-center font-bold text-sm">
                ↓
              </div>
              <div className="min-w-0">
                <div className="text-[11px] font-semibold text-slate-400 truncate">إجمالي المصاريف</div>
                <div className="text-sm sm:text-base font-black text-red-500 dark:text-red-400 truncate">
                  {format(totals.expense)}
                </div>
              </div>
            </div>
          </div>
        </aside>

        {/* Main Column: Transactions List */}
        <main className="lg:col-span-8 space-y-4">
          {txLoading ? (
            <div className="space-y-4">
              {[1, 2, 3].map((i) => (
                <div
                  key={i}
                  className="h-28 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-700/60 animate-pulse"
                />
              ))}
            </div>
          ) : dayGroups.length === 0 ? (
            <EmptyState
              icon={<ArrowLeftRight className="w-8 h-8" />}
              title={
                query || filterType !== 'all' || selectedCategory !== 'all'
                  ? 'لا توجد معاملات مطابقة للفلترة'
                  : 'لا توجد معاملات لهذا الشهر'
              }
              description="ابدأ بتسجيل مصاريفك أو مداخيلك لمتابعة ميزانيتك أولاً بأول."
              action={
                <Button
                  variant="primary"
                  size="md"
                  icon={<Plus className="w-4 h-4 stroke-[2.5]" />}
                  onClick={() => openAdd('expense')}
                >
                  إضافة أول معاملة
                </Button>
              }
            />
          ) : (
            <div className="space-y-5">
              {dayGroups.map((group) => {
                const dayNetFils = group.transactions.reduce((acc, tx) => {
                  return tx.type === 'income' ? acc + tx.amountFils : acc - tx.amountFils
                }, 0)

                return (
                  <div key={group.dateKey} className="space-y-2">
                    {/* Day Header with clearly displayed net spend */}
                    <div className="flex items-center justify-between px-1 text-xs font-bold text-slate-500 dark:text-slate-400">
                      <div className="flex items-center gap-2">
                        <Calendar className="w-3.5 h-3.5" />
                        <span>{formatDayHeader(group.date, today)}</span>
                      </div>
                      <div className="flex items-center gap-1.5">
                        <span className="text-[11px] text-slate-400 font-medium">صافي اليوم:</span>
                        <span
                          className={cn(
                            'font-extrabold text-xs select-none',
                            dayNetFils > 0
                              ? 'text-emerald-600 dark:text-emerald-400'
                              : dayNetFils < 0
                                ? 'text-red-500 dark:text-red-400'
                                : 'text-slate-400'
                          )}
                        >
                          {dayNetFils > 0
                            ? `+ ${format(dayNetFils)}`
                            : dayNetFils < 0
                              ? `- ${format(Math.abs(dayNetFils))}`
                              : format(0)}
                        </span>
                      </div>
                    </div>

                    {/* Transactions in this day */}
                    <div className="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 shadow-xs divide-y divide-slate-100 dark:divide-slate-700/50 overflow-hidden">
                      {group.transactions.map((tx) => {
                        const cat = categoryMap.get(tx.categoryId)
                        const icon = cat?.icon ?? '➕'
                        const color = cat?.color ?? '#94A3B8'
                        const name = cat?.name ?? 'غير مصنف'
                        const isExpense = tx.type === 'expense'

                        return (
                          <div
                            key={tx.id}
                            onClick={() => openEdit(tx)}
                            className="group flex items-center justify-between p-3 sm:p-3.5 hover:bg-slate-50 dark:hover:bg-slate-750 transition-colors cursor-pointer"
                          >
                            {/* Right side: Emoji circle + Category Name + Note */}
                            <div className="flex items-center gap-3 min-w-0 flex-1 pe-3">
                              <div
                                className="w-9 h-9 sm:w-10 sm:h-10 rounded-full flex items-center justify-center text-base sm:text-lg shrink-0"
                                style={{ backgroundColor: `${color}20` }}
                              >
                                {icon}
                              </div>

                              <div className="min-w-0 flex-1">
                                <div className="flex items-center gap-2 flex-wrap">
                                  <span className="font-bold text-xs sm:text-sm text-slate-800 dark:text-slate-100 truncate">
                                    {tx.title || name}
                                  </span>
                                  {tx.id.startsWith('debt_') && (
                                    <span className="inline-flex items-center gap-1 text-[10px] px-1.5 py-0.5 rounded-full bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border border-amber-200/80 dark:border-amber-800 font-bold shrink-0">
                                      <HandCoins className="w-2.5 h-2.5" />
                                      <span>دين</span>
                                    </span>
                                  )}
                                  {tx.recurringId && (
                                    <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 font-semibold shrink-0">
                                      متكررة
                                    </span>
                                  )}
                                </div>

                                <div className="flex items-center gap-1.5 text-[11px] text-slate-400 dark:text-slate-400 truncate mt-0.5">
                                  {tx.title ? (
                                    <>
                                      <span className="font-medium text-slate-500 dark:text-slate-400">{name}</span>
                                      {tx.note ? <span>•</span> : null}
                                    </>
                                  ) : null}
                                  {tx.note ? <span>{tx.note}</span> : null}
                                </div>
                              </div>
                            </div>

                            {/* Left side: Amount Pill & Actions */}
                            <div className="flex items-center gap-1.5 sm:gap-2 shrink-0">
                              {/* Amount Pill */}
                              <div
                                className={cn(
                                  'font-bold text-xs sm:text-sm px-2.5 sm:px-3 py-1.5 rounded-xl select-none',
                                  isExpense
