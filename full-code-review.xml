.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

/* Ensure buttery smooth momentum scrolling on iOS Safari and mobile webviews */
.smooth-touch-scroll {
  -webkit-overflow-scrolling: touch;
  overscroll-behavior-y: contain;
  touch-action: pan-y;
